---
import CollectionEntryLayout from "@layouts/CollectionEntryLayout.astro";
import globalConfig from "@lib/config";
import { streamsCollection } from "@src/content.config";

const { setStreamTitle } = globalConfig.utils;

export async function getStaticPaths() {
	const { setDynamicPage } = globalConfig.utils;
	let id = "";

	return setDynamicPage(streamsCollection, "streams", id);
}

const { entry } = Astro.props ?? {};
---

<CollectionEntryLayout
	{entry}
	metaTitle={setStreamTitle(entry.current, "Live Stream")}
	title={setStreamTitle(entry.current)}
/>
