---
import CardGalleryEntry from "@components/CardGalleryEntry.astro";
import Hero from "@components/Hero.astro";
import Button from "@components/ui/Button.astro";
import Grid from "@components/ui/Grid.astro";
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import globalConfig from "@lib/config";
import { toolsCollection } from "@src/content.config";

const { setWarning, titleCase } = globalConfig.utils ?? {};

if (!globalConfig) {
	setWarning("Landing Page", "globalConfig");
	return null;
}

const { brand } = globalConfig;
const seo = {
	title: "Home",
	metaTitle: titleCase(brand.bio || ""),
	description:
		"A gallery of 3d models of 1:1 roller coasters built from open source tools made using NoLimits 2 and Blender",
};
---

<GlobalLayout breadcrumbs={false} {...seo} hook>
	<div class="relative">
		<GlobalGrid>
			<Container layout="body">
				<Hero position="left" />
			</Container>
		</GlobalGrid>
	</div>
	<GlobalGrid>
		<Container class="flex flex-col gap-16" layout="content">
			<section class="flex flex-col gap-8">
				<h2 class="text-center text-lg">Most Recent Commissions</h2>
				<Grid class="gap-4" size="md" tag="ul">
					{
						[...toolsCollection].map((entry) => (
							<li>
								<CardGalleryEntry {entry} />
							</li>
						))
					}
				</Grid>
				<Button
					href="/portfolio"
					label="View all work"
					varient="secondary"
					icon={["arrow-right", "right"]}
				/>
			</section>
		</Container>
	</GlobalGrid>
</GlobalLayout>
