---
import CardBlogPost from "@components/CardBlogPost.astro";
import CardGalleryEntry from "@components/CardGalleryEntry.astro";
import Hero from "@components/Hero.astro";
import SketchfabEmbed from "@components/SketchfabEmbed.astro";
import Button from "@components/ui/Button.astro";
import Grid from "@components/ui/Grid.astro";
import Icon from "@components/ui/Icon.astro";
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import globalConfig from "@lib/config";
import { resourcesCollection, streamsCollection, toolsCollection } from "@src/content.config";

const { findContent, getProjectID, setStreamTitle, setWarning, titleCase } =
	globalConfig.utils ?? {};

if (!globalConfig) {
	setWarning("Landing Page", "globalConfig");
	return null;
}

const { brand } = globalConfig;
const seo = {
	title: "Home",
	metaTitle: titleCase(brand.bio || ""),
	description:
		"A gallery of 3d models of 1:1 roller coasters built from open source tools made using NoLimits 2 and Blender",
};
const featuredModel = findContent("models", "poltergeist");
---

<GlobalLayout breadcrumbs={false} {...seo} hook>
	<div class="relative flex flex-col gap-8 lg:pb-12">
		<Hero position="left" />
	</div>
	<GlobalGrid>
		<Container class="flex flex-col gap-16 lg:-mt-32" layout="content">
			<section class="flex flex-col gap-8">
				<div class="flex gap-2">
					<Icon class="text-brand-body-text" name="stream" />
					<h2 class="eyebrow">Live 3D Model</h2>
				</div>
				<div class="aspect-video w-full">
					<SketchfabEmbed url={featuredModel?.data.sketchfabUrl || ""} />
				</div>
				<Button
					href={`/models/${getProjectID(featuredModel)}`}
					label="View model details"
					icon={["arrow-right", "right"]}
					varient="outline"
				/>
			</section>
			<section class="flex flex-col gap-8">
				<div class="flex flex-col gap-4">
					<h2 class="eyebrow">Newest Open Sourced Tools</h2>
					<Grid class="gap-8" size="sm" tag="ul">
						{
							toolsCollection.slice(0, 3).map((entry) => (
								<li class="aspect-square">
									<CardGalleryEntry {entry} size="md" />
								</li>
							))
						}
					</Grid>
				</div>
				<Button
					href="/tools"
					label="View all tools"
					icon={["arrow-right", "right"]}
					varient="outline"
				/>
			</section>
			<section class="flex flex-col gap-8">
				<div class="flex flex-col gap-4">
					<h2 class="eyebrow">Guides and Resources</h2>
					<Grid class="gap-8" size="sm" tag="ul">
						{
							resourcesCollection.slice(0, 3).map((entry) => (
								<li class="aspect-square">
									<CardGalleryEntry {entry} size="md" />
								</li>
							))
						}
					</Grid>
				</div>
				<Button
					href="/resources"
					label="View all resources"
					icon={["arrow-right", "right"]}
					varient="outline"
				/>
			</section>
			<section class="flex flex-col gap-8">
				<div class="flex flex-col gap-4">
					<h2 class="eyebrow">Live Streamed Devlogs</h2>
					<ul class="flex flex-col gap-4">
						{
							streamsCollection.slice(0, 9).map((entry) => (
								<li class="w-full">
									<CardBlogPost {entry} label={setStreamTitle(entry)} />
								</li>
							))
						}
					</ul>
				</div>
			</section>
		</Container>
	</GlobalGrid>
</GlobalLayout>
