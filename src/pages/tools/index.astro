---
import CardGalleryEntry from "@components/CardGalleryEntry.astro";
import Grid from "@components/ui/Grid.astro";
import CollectionLayout from "@layouts/CollectionLayout.astro";
import { toolsCollection } from "@src/content.config";
---

<CollectionLayout
	collection="tools"
	data={{
		title: "Tools",
		description: "Description",
		//
	}}
>
	<Grid class="gap-8" size="sm" tag="ul">
		{
			toolsCollection.map((entry) => (
				<li class:list={["flex aspect-square w-full flex-col gap-1"]}>
					<CardGalleryEntry {entry} size="md" />
				</li>
			))
		}
	</Grid>
</CollectionLayout>
