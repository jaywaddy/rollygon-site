---
import CardGalleryEntry from "@components/CardGalleryEntry.astro";
import Grid from "@components/ui/Grid.astro";
import CollectionLayout from "@layouts/CollectionLayout.astro";
import { toolsCollection } from "@src/content.config";
---

<CollectionLayout
	data={{
		title: "Tools",
		metaTitle:
			"Free and open sourced tools made in Blender for building 3D roller coaster models",
		description:
			"These tools are the building blocks to every project. From track and support generators to the atoms of every geometry node.",
		//
	}}
>
	<Grid class="gap-8" size="sm" tag="ul">
		{
			toolsCollection.map((entry) => (
				<li class:list={["flex aspect-square w-full flex-col gap-1"]}>
					<CardGalleryEntry {entry} size="md" />
				</li>
			))
		}
	</Grid>
</CollectionLayout>
