---
import CollectionEntryLayout from "@layouts/CollectionEntryLayout.astro";
import globalConfig from "@lib/config";
import { toolsCollection } from "@src/content.config";

export async function getStaticPaths() {
	const { setDynamicPage } = globalConfig.utils;
	let id = "";

	return setDynamicPage(toolsCollection, "tools", id);
}

const { entry } = Astro.props ?? {};
---

<CollectionEntryLayout
	{entry}
	metaTitle={`${entry.current.data.title} | Open Source 3D Roller Coaster Modeling Tool Made in Blender`}
/>
