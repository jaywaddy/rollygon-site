---
import CollectionEntryLayout from "@layouts/CollectionEntryLayout.astro";
import globalConfig from "@lib/config";
import { resourcesCollection } from "@src/content.config";

export async function getStaticPaths() {
	const { setDynamicPage } = globalConfig.utils;
	let id = "";

	return setDynamicPage(resourcesCollection, "resources", id);
}

const { entry } = Astro.props ?? {};
---

<CollectionEntryLayout
	{entry}
	metaTitle={`${entry.current.data.title} | 3D Roller Coaster Model Documentation`}
/>
