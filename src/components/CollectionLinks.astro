---
import globalConfig from "@lib/config";
import type { TCategory, TCollection, TCollectionGroup } from "@lib/utils/types";
import { collectionsList } from "@src/content.config";
import type { CollectionEntry } from "astro:content";
import Grid from "@components/ui/Grid.astro";
const { getProjectID, setHref, setStreamTitle } = globalConfig.utils ?? {};

type Props = { class?: string };

const { class: className } = Astro.props;
const { navigation } = globalConfig;
const maxLinks = 5;

const navLinks: TCategory[] = navigation.categories.filter((link) => {
	return link.href !== "/" && !link.collection;
});

const collectionGroups = [
	...populateFooterGroups(...collectionsList),
	{ label: "Information", links: [...navLinks] },
];

function populateFooterGroups(...data: CollectionEntry<TCollection>[][]): TCollectionGroup[] {
	return data.map((entries) => {
		const collection = entries[0].collection;
		const isStream = collection === "streams";
		const setLinkHref = function (entry: CollectionEntry<TCollection>) {
			return entry.collection === "streams"
				? `/${entry.data.collection}/${getProjectID(entry)}/streams/${getProjectID(entry, "path")}`
				: setHref(entry);
		};

		return {
			icon: collection,
			label: isStream ? `Latest ${collection}` : collection,
			links: entries.map((entry) => ({
				href: setLinkHref(entry),
				label: isStream ? setStreamTitle(entry) : entry.data.title,
			})),
			plural: isStream ? undefined : entries[0].data.plural || "",
		};
	});
}
---

<Grid class:list={["gap-x-8 gap-y-16", className]} size="sm">
	{
		collectionGroups.map((group) => (
			<ul class="flex flex-col gap-2 max-lg:gap-4">
				<li>
					<span class="eyebrow">{group.label}</span>
				</li>
				{group.links?.slice(0, maxLinks).map(({ href, label }) => (
					<li class="">
						<a class="link" {href}>
							{label}
						</a>
					</li>
				))}
				{group.plural && (
					<li>
						<a class="link text-50" href={`/${group.label}`}>
							View all{group.plural && ` ${group.plural}`}
						</a>
					</li>
				)}
			</ul>
		))
	}
</Grid>
