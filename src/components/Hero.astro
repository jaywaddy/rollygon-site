---
import Container from "@layouts/Container.astro";
import globalConfig from "@lib/config";
import Button from "@components/ui/Button.astro";
import Img from "@components/ui/Img.astro";

import bgPattern from "@assets/bg-pattern.png";

type Props = {
	position: "left" | "center" | "right";
	//
};

const { brand, navigation } = globalConfig;
const { position } = Astro.props;

const alignment: { [key in typeof position]: string } = {
	left: "",
	center: "flex-col items-center text-center",
	right: "items-end text-right",
};
---

<>
	<Img class="absolute inset-0 h-full rounded-none mix-blend-overlay opacity-30" src={bgPattern} />
	<section
		class:list={["relative flex gap-8 py-16 pt-40 max-lg:pt-48 lg:my-32", alignment[position]]}
	>
		<div class="flex flex-col gap-8">
			<div class:list={["flex flex-col gap-4", alignment[position]]}>
				<span class="eyebrow text-brand-body-text">{brand.bio}</span>
				<h1 class="max-w-2xl">{brand.heading}</h1>
				<p class="lead max-w-lg">{brand.subheading}</p>
			</div>
			<div
				class:list={[
					"flex gap-4",
					alignment[position],
					position === "center" && "flex-col",
				]}
			>
				<Button {...navigation.cta} varient={["primary", "lg"]} />
				<Button
					class="text-70 hover:text-100"
					href="/pricing"
					icon="info"
					label="View pricing"
					varient="link"
				/>
			</div>
		</div>
	</section>
</>
