---
// import ImageWrapper from "@/ui/ImageWrapper.astro";
import CommissionBanner from "@/ui/CommissionBanner.astro";
import SocialLink from "@/components/SocialLink.astro";
import Button from "../ui/Button.astro";
import { SOCIAL_LINK, type HTML } from "@/scripts/constants";
import DonateButton from "../ui/DonateButton.astro";

interface Props extends HTML {
	photo?: boolean;
}

const { photo, class: className } = Astro.props;
const { gumroad, sketchfab, youtube, bluesky, kofi, email } = SOCIAL_LINK;
---

{
	photo ? (
		<div
			class:list={`${className}`}
			style={{ "--radius": "32px" }}
		>
			{/* <ImageWrapper alt="About photo" size="md" shape="round" aspect="1/1" src="/about/about.png" /> */}
			<div class="absolute top-2 -rotate-4">
				<CommissionBanner />
			</div>
			<p class="absolute card-sm bottom-2 rotate-2">
				I'm Jay, and I make roller coasters out of polygons!
			</p>
			<SocialLink
				icon={gumroad.icon}
				href={gumroad.href}
				rotation="105"
			/>
			<SocialLink
				icon={sketchfab.icon}
				href={sketchfab.href}
				rotation="125"
			/>
			<SocialLink
				title={youtube.title}
				icon={youtube.icon}
				href={youtube.href}
				rotation="145"
			/>
			<SocialLink
				icon={bluesky.icon}
				href={bluesky.href}
				rotation="165"
			/>
		</div>
	) : (
		<aside class={`column-md card ${className}`}>
			<CommissionBanner />
			<p>My name is Jay, and I'm a solo dev who makes roller coasters out of polygons!</p>
			<DonateButton size="100%"/>
			<div class="row-sm">
				<Button icon={gumroad.icon} href={gumroad.href} iconOnly />
				<Button icon={sketchfab.icon} href={sketchfab.href} iconOnly />
				<Button icon={youtube.icon} href={youtube.href} iconOnly />
				<Button icon={email.icon} href={email.href} iconOnly />
			</div>
		</aside>
	)
}
