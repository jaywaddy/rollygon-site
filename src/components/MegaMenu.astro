---
import { type TCollection } from "@lib/utils/types";
import Button from "@components/ui/Button.astro";
import CardGalleryEntry from "./CardGalleryEntry.astro";
import { allCollections } from "@src/content.config";
import globalConfig from "@lib/config";

type Props = { collection?: TCollection; index: number };

const { collection, index } = Astro.props;

if (!collection) {
	return null;
}

const { sortCollection } = globalConfig.utils;
const resources = sortCollection([...allCollections["resources"], ...allCollections["streams"]]);
const collectionList = collection === "resources" ? resources : allCollections[collection];
const gridSize = () => {
	if (collectionList.length <= 1) {
		return "grid-cols-[repeat(1,--spacing(52))]";
	}

	if (collectionList.length === 2) {
		return "grid-cols-[repeat(2,--spacing(52))]";
	}

	return "grid-cols-[repeat(3,--spacing(52))]";
};
---

<div
	class:list={["mega-menu-container absolute inset-auto left-[50%] translate-x-[-50%] pt-4"]}
	role="menu"
>
	<div
		class:list={[
			"rounded-tl-cta bg-primary border-outline rigfht-[50%] absolute top-2 left-[50%] aspect-square w-4 translate-x-[-50%] rotate-45 border-t border-l",
		]}
	>
	</div>
	<div
		class:list={[
			"bg-primary rounded-element border-outline -z-10 flex h-fit flex-col gap-4 border p-4 [box-shadow:0px_0px_--spacing(8)_var(--color-shadow)]",
			index === 0 && "max-xl:translate-x-[25%]",
		]}
	>
		<ul class:list={["menu grid gap-2", gridSize()]}>
			{
				[...collectionList].slice(0, 3).map((entry) => (
					<li class="aspect-square">
						<CardGalleryEntry {entry} size="sm" />
					</li>
				))
			}
		</ul>
		<Button
			href={`/${collection}`}
			label={`View all${` ${collectionList[0]?.data.plural}` || ""}`}
			varient="outline"
			icon={["arrow-right", "right"]}
		/>
	</div>
</div>
