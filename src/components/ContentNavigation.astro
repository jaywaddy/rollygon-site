---
import Button from "@/ui/Button.astro";
import type { Collection } from "@/content.config";
import { slugify } from "@/scripts/utilities";

interface Props {
	content: Collection;
	contentCollection: Array<Collection>;
	index: number;
}

const { content, contentCollection, index } = Astro.props;
const { collection } = content;

const contentCount = contentCollection.length - 1;
const prevIsDisabled = index === contentCount;
const nextIsDisabled = index === 0;

function setNextHref(): string {
	return nextIsDisabled
		? slugify(contentCollection[0].data.title) 
		: slugify(contentCollection[index - 1].data.title);
}

function setPrevHref(): string {
	return prevIsDisabled
		? slugify(contentCollection[contentCount].data.title)
		: slugify(contentCollection[index + 1].data.title);
}
---

<div class="pagination border">
	<Button
		label={`All ${collection}`}
		href={`/${collection}`}
		small
	/>
	<ul class="row-sm">
		<li>
			<Button
				label="Prev"
				icon="arrow-left"
				href=`/${collection}/${setPrevHref()}`
				disabled={prevIsDisabled}
				dataLayout="desktop"
				small
			/>
			<Button
				label="Prev"
				icon="arrow-left"
				href=`/${collection}/${setPrevHref()}`
				disabled={prevIsDisabled}
				dataLayout="mobile"
				small
				iconOnly
			/>
		</li>
		<li>
			<Button
				label="Next"
				icon="arrow-right"
				href=`/${collection}/${setNextHref()}`
				disabled={nextIsDisabled}
				dataLayout="desktop"
				iconRight
				small
			/>
			<Button
				label="Next"
				icon="arrow-right"
				href=`/${collection}/${setNextHref()}`
				disabled={nextIsDisabled}
				dataLayout="mobile"
				iconRight
				small
				iconOnly
			/>
		</li>
	</ul>
</div>

<style>
	li {
		display: flex;
		list-style: none;
	}
</style>
