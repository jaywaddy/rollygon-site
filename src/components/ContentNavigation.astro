---
import Button from "@/ui/Button.astro";
import type { Collection } from "@/content.config";

interface Props {
	content: Collection;
	contentCollection: Array<Collection>;
	index: number;
}

const { content, contentCollection, index } = Astro.props;
const { collection } = content;

const max = contentCollection.length - 1;
const prevIsDisabled = index === max;
const nextIsDisabled = index === 0;

function setNextHref(): string {
	return nextIsDisabled
		? contentCollection[0].slug
		: contentCollection[index - 1].slug;
}

function setPrevHref(): string {
	return prevIsDisabled
		? contentCollection[max].slug
		: contentCollection[index + 1].slug;
}
---

<div class="pagination border">
	<Button
		label={`All ${collection}`}
		href={`/${collection}`}
		small
	/>
	<ul class="row-sm">
		<li>
			<Button
				label="Prev"
				icon="arrow-left"
				href=`/${collection}/${setPrevHref()}`
				disabled={prevIsDisabled}
				dataLayout="desktop"
				small
			/>
			<Button
				label="Prev"
				icon="arrow-left"
				href=`/${collection}/${setPrevHref()}`
				disabled={prevIsDisabled}
				dataLayout="mobile"
				small
				iconOnly
			/>
		</li>
		<li>
			<Button
				label="Next"
				icon="arrow-right"
				href=`/${collection}/${setNextHref()}`
				disabled={nextIsDisabled}
				dataLayout="desktop"
				iconRight
				small
			/>
			<Button
				label="Next"
				icon="arrow-right"
				href=`/${collection}/${setNextHref()}`
				disabled={nextIsDisabled}
				dataLayout="mobile"
				iconRight
				small
				iconOnly
			/>
		</li>
	</ul>
</div>

<script is:inline define:vars={{ phCollection: collection }}>
	document.querySelectorAll('.pagination ul a').forEach(function(link) {
		link.addEventListener('click', function() {
			var direction = link.getAttribute('title')?.toLowerCase();
			window.posthog?.capture('content_navigation_clicked', {
				direction: direction,
				collection: phCollection,
			});
		});
	});
</script>

<style>
	li {
		display: flex;
		list-style: none;
	}
</style>
