---
import Icon, { type ICON_NAME } from "@/ui/Icon.astro";
import { titleCase } from "@/scripts/utilities";
import type { HTML } from "@/scripts/constants";

interface Props extends HTML {
	id?: string;
	type?: "submit" | "toggle" | "link";
	label?: string;
	href?: string;
	iconRight?: boolean;
	icon?: ICON_NAME;
	iconOnly?: boolean;
	disabled?: boolean;
	fullWidth?: boolean;
	primary?: boolean;
	small?: boolean;
	dataLayout?: "desktop" | "mobile";
	price?: string;
}

const {
	id,
	type = "link",
	label,
	href,
	icon = "arrow-up-left",
	iconRight = false,
	iconOnly = false,
	disabled,
	fullWidth = false,
	primary,
	small,
	dataLayout,
	class: className,
	price = null,
} = Astro.props;

const buttonStyles = "button row-xs center";
const isSingular = label?.length === 1 || false;

function setButtonColor (isPrimary: boolean | undefined): string {
	if (isPrimary) {
		return (`
			--bg-light: var(--brand-bg);
			--bg-hover: var(--brand-bg-hover);
			--outline: var(--brand-outline);
			--outline-hover: var(--brand-outline-hover);
		`);
	}
	
	return "--button-bg: var(--bg-light);";
}

function setAspectRatio(hasLabel: string | undefined): string {
	const fixedWidth = "min-width: var(--padding-y);"
	
	return hasLabel && hasLabel.length <= 1 ? fixedWidth : "";
}

function setButtonStyles(): string {
	return (`
		${setButtonColor(primary)}
		${setAspectRatio(label)}
	`);
}
---

{type === "submit" && (
	<button
		{id}
		data-disabled={disabled}
		data-icon-only={iconOnly}
		data-width={fullWidth}
		data-layout={dataLayout}
		data-is-small={small || false}
		data-is-singular={isSingular}
		{type}
		title={label}
		class:list={[buttonStyles, className]}
		style={setButtonStyles()}
	>
		{!iconRight && icon !== "none" && <Icon name={icon} {disabled} />}
		{label && label}
		{iconRight && icon !== "none" && <Icon name={icon} {disabled} />}
	</button>
)}
{type === "toggle" && (
	<button
		{id}
		data-disabled={disabled}
		data-icon-only={iconOnly}
		data-width={fullWidth}
		data-is-checked="false"
		data-layout={dataLayout}
		data-is-small={small || false}
		data-is-singular={isSingular}
		title={label ? label : titleCase(icon)}						
		class:list={[buttonStyles, className]}
		style={setButtonStyles()}
	>
		{!iconRight && icon !== "none" && <Icon name={icon} {disabled} />}
		{label && !iconOnly && label}
		{iconRight && icon !== "none" && <Icon name={icon} {disabled} />}
	</button>
)}
{
	type === "link" && (
		<a
			{id}
			{href}
			data-disabled={disabled}
			data-icon-only={iconOnly}
			data-width={fullWidth}
			data-layout={dataLayout}
			data-is-small={small || false}
			data-is-singular={isSingular}
			title={label ? label : titleCase(icon)}
			class:list={[buttonStyles, className]}			
			style={setButtonStyles()}
		>
			{!iconRight && icon !== "none" && <Icon name={icon} {disabled} />}
			{label && !iconOnly && <span>{label}</span>}
			{price && <span class="price">{price}</span>}
			{iconRight && icon !== "none" && <Icon name={icon} {disabled} />}
		</a>
	)
}

<style>
	.button {
		--button-radius: var(--radius-sm);
		--padding-y: var(--space-3);
		--padding-x: calc(var(--padding-y) * 2);
		--padding-icon: calc(var(--padding-y) + var(--space-1));

		display: flex;
		justify-content: center;
		align-items: center;

		font-weight: var(--font-semibold);
		text-wrap: nowrap;

		min-width: fit-content;
		padding: var(--padding-y) var(--padding-x);
		border-radius: var(--button-radius);
		border: var(--border);
		border-color: var(--outline);
		background-color: var(--bg-light);
		color: var(--text);

		cursor: pointer;

		transition: all 0.1s;

		.price {
			margin-left: var(--space-2);
			padding-left: var(--space-2);
			border-left: var(--border);
			border-color: var(--outline);
		}

		span {
			color: currentColor;
		}

		&:hover {
			background: var(--bg-hover);
			border-color: var(--outline-hover);
			color: var(--text-hover);
		}

		&:hover .price {
			border-color: var(--outline-hover);
		}

		&:active {
			background: var(--bg-active);
		}
	}

	[data-disabled="true"] {
		color: var(--text-muted);
		background: var(--bg-muted);
		border-color: none;
		pointer-events: none;
		cursor: not-allowed;

		span {
			color: var(--text-muted);
		}
	}

	[data-icon-only="true"] {
		padding-inline: var(--padding-icon);
		aspect-ratio: 1/1;
	}

	[data-width="true"] {
		min-width: 100%;

		svg {
			max-width: fit-content;
		}
	}

	[data-width="false"] {
		max-width: fit-content;
	}

	[data-is-small="false"] {
		height: 54px;
	}

	[data-is-small="true"] {
		height: 42px;
		padding: var(--space-2);
		border-radius: var(--radius-pill);
	}

	[data-is-small="true"]:has(span) {
		padding-inline: var(--space-4);
	}

	[data-is-singular="true"] {
		padding: 0;
		border-radius: var(--radius-pill);
		height: 42px;
		aspect-ratio: 1/1;
	}
</style>
