---
import Icon, { type TIcon } from "./Icon.astro";

export type TButtonSize = "sm" | "md" | "lg";
export type TButtonStyle = "primary" | "secondary" | "ghost" | "outline" | "link";
export type TIconPosition = "left" | "right";

export type TButton = {
	arriaCurrent?: "page" | undefined;
	bgHover?: string;
	disabled?: boolean;
	varient?: TButtonStyle | [TButtonStyle, TButtonSize];
	class?: string;
	collection?: string;
	full?: boolean;
	href?: string;
	label?: string;
	icon?: TIcon | [TIcon, TIconPosition?];
	icons?: [TIcon, TIconPosition?][];
	iconOnly?: boolean;
	id?: string;
	isExternal?: boolean;
	noIcon?: boolean;
	style?: string;
};

type Props = TButton;

const {
	arriaCurrent,
	disabled = false,
	varient = "primary",
	class: classAttribute,
	collection,
	full = false,
	href,
	label,
	icon = collection ? ["chevron-down", "right"] : ["none", "left"],
	icons,
	iconOnly = false,
	id,
	isExternal,
	noIcon = false,
	style: styleAttribute,
} = Astro.props;

const size = typeof varient === "string" ? "md" : varient[1];
const style = typeof varient === "string" ? varient : varient[0] || "primary";
const iconName = typeof icon === "string" ? icon : icon[0] || "at-sign";
const iconPosition = typeof icon === "string" ? "left" : icon[1] || "left";
const target = isExternal ? "_blank" : undefined;

const buttonSizes: { [key in TButtonSize]: string } = {
	sm: iconOnly ? "px-1 pb-0.25" : "px-2 pb-0.25 text-sm",
	md: collection
		? "pl-3 pr-1 py-1.5 text-[0.875rem]"
		: iconOnly
			? "aspect-square p-[calc(--spacing(1)+0.5px)]"
			: "px-3 py-1.5 text-[0.875rem]",
	lg: iconOnly ? "aspect-square p-2" : "font-[500] px-7 py-3.5",
};

const buttonStyles: { [key in TButtonStyle]: string[] } = {
	primary: [
		"bg-brand text-brand-text outline-0.5",
		disabled ? "" : "hover:bg-brand-hover active:bg-brand-active",
	],
	secondary: [
		"bg-secondary",
		disabled ? "" : "hover:bg-secondary-hover active:bg-secondary-active",
	],
	ghost: [disabled ? "" : "hover:bg-secondary-hover active:bg-secondary-active"],
	outline: [
		"bg-primary outline-outline outline",
		disabled ? "" : "hover:bg-primary-hover active:bg-primary-active",
	],
	link: ["relative text-[0.875rem] active:text-50", disabled ? "" : "hover:underline"],
};

const iconPositions: { [key in TIconPosition]: string } = {
	left: "flex-row",
	right: "flex-row-reverse",
};

const iconStrokeWidths: { [key in TButtonSize]: string } = {
	sm: "[&_path]:stroke-[2px]",
	md: "[&_path]:stroke-[2.5px]",
	lg: "[&_path]:stroke-[2.8px]",
};

const CtaTag = href ? "a" : "label";
const LabelTag = size === "sm" ? "small" : "span";
---

<CtaTag
	{id}
	{href}
	{target}
	aria-disabled={disabled}
	data-toggle={iconOnly ? "false" : undefined}
	style={styleAttribute}
	class:list={[
		"rounded-cta relative flex items-center justify-center gap-1 text-nowrap [&_svg]:h-4",
		buttonStyles[style],
		disabled ? "cursor-not-allowed opacity-60" : "cursor-pointer",
		classAttribute,
		collection && "collection",
		!full && "w-fit",
		iconPositions[iconPosition],
		style !== "link" && `font-[450] ${buttonSizes[size]}`,
	]}
	aria-current={arriaCurrent}
>
	{
		iconName !== "none" && !icons && !noIcon && (
			<span class:list={[iconStrokeWidths[size], size === "sm" && "[&_svg]:w-3"]}>
				<Icon name={iconName} />
			</span>
		)
	}
	{
		icons && !noIcon && (
			<div
				class:list={[
					"[&_.icon-2]:hidden",
					"has-checked:[&_.icon-1]:hidden",
					"has-checked:[&_.icon-2]:block",
				]}
			>
				{icons.map((_icon, index) => (
					<span
						id={`${_icon[0]}-icon`}
						class:list={[
							iconStrokeWidths[size],
							size === "sm" && "[&_svg]:w-3",
							`icon-${index + 1}`,
						]}
					>
						<Icon name={_icon[0]} />
					</span>
				))}
				<input
					class:list={["button-checkbox absolute h-0 w-0 opacity-0"]}
					type="checkbox"
				/>
			</div>
		)
	}
	{iconOnly ? null : <LabelTag>{label}</LabelTag>}
</CtaTag>
