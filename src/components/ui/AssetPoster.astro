---
import { Collection } from '@/content.config';
import { setImageSrc } from '@/scripts/utilities';

interface Props {
	content: Collection; 
}

const { content } = Astro.props; 

function setAspectRatio(content: Collection) {
	if (content.collection === "tools") {
		return "16/5";
	}

	return "16/9";
}
---

<div style={`--aspect: ${setAspectRatio(content)};`} class="asset-poster">
	<div class="asset">
		{content.collection === "models" && (
			<iframe
				id="poster-model"
				title={content.data.title}
				frameborder="0"
				allowfullscreen
				allowfullscreen="true"
				allow="autoplay; fullscreen; xr-spatial-tracking"
				xr-spatial-tracking
				execution-while-out-of-viewport
				execution-while-not-rendered
				web-share
				src={"https://sketchfab.com/models/" +
					content.data.id +
					"/embed?autostart=1&annotations_visible=1&transparent=0&ui_theme=dark&dnt=1"}
			></iframe>
		)}
		{content.collection === "posts" && (
			content.data.embed ? (
				<iframe
					id="poster-video"
					src={`https://www.youtube.com/embed/${content.data.embed}`}
					title="YouTube video player"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			) : (
				<img id="posts-header" src={setImageSrc(content, "poster")} alt={content.data.title} />
			)
		)}
		{content.collection === "tools" && (
			<img src={setImageSrc(content, "banner")} alt={content.data.title} />
			<div class="programs">
				<img src="/images/blender.png" alt="" />
			</div>
		)}
	</div>
</div>

<style>
	.asset-poster {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;

		aspect-ratio: var(--aspect);

		border: var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg-light);
		color: var(--text);
	}

	.asset {
		position: absolute;
		inset: var(--padding-sm);

		overflow: clip;

		border-radius: var(--radius-md);
		border: var(--border);
		background: black;
	}

	#poster-video {
		width: 100%;
		height: 100%;
	}

	#poster-model {
		width: 100%;
		height: 100%;
	}

	.programs {
        position: absolute;
		display: flex;
		gap: var(--space-4);
        inset: var(--space-8) var(--space-8) auto;

		img {
			width: 64px;
			height: auto;
		}
    }
</style>
