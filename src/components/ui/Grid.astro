---
import type { HTMLTag } from "astro/types";

export type TGridSizes = "xs" | "sm" | "md" | "lg" | "full";

type Props = { class?: string; size: TGridSizes; tag?: HTMLTag };

const { class: className, size = "lg", tag = "div" } = Astro.props;

const Tag = tag;
const colSizes: { [key in typeof size]: string } = {
	xs: "[--min-col-size:12rem]",
	sm: "[--min-col-size:18rem]",
	md: "[--min-col-size:24rem]",
	lg: "[--min-col-size:28rem]",
	full: "[--min-col-size:100%]",
};
---

<Tag class:list={["site-grid", colSizes[size], className]}>
	<slot />
</Tag>
