---
import Icon from "./Icon.astro";
import Img from "./Img.astro";
import bgPattern from "@assets/bg-pattern-alt.png";
---

<div class="absolute inset-0 flex h-full w-full items-center justify-center">
	<Img src={bgPattern} class="h-full opacity-20" />
	<div class="absolute m-auto flex flex-col items-center">
		<span>Loading</span>
		<Icon class="w-4 animate-spin" name="loading" />
	</div>
</div>
