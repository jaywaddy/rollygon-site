---
import { Image as AstroImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import fallback from "@assets/fallback.png";

type Props = {
	alt?: string | null;
	aspectRatio?: "square" | "video" | "4/3" | "auto";
	class?: string;
	height?: number;
	layout?: "constrained" | "full-width" | "fixed" | "none";
	loading?: "lazy" | "eager";
	quality?: number;
	responsive?: boolean;
	sizes?: string;
	src?: ImageMetadata | undefined;
	width?: number;
};

const {
	alt,
	aspectRatio = "auto",
	class: className,
	height = 720,
	layout = "constrained",
	loading = "lazy",
	quality = 80,
	responsive = true,
	sizes,
	src,
	width = 1280,
} = Astro.props;

if (height <= 0 || width <= 0) {
	console.warn("Image: height and width must be positive numbers");
	return null;
}

const aspectRatios: { [key in typeof aspectRatio]: string } = {
	"4/3": "aspect-[4/3] object-cover",
	"auto": "w-full h-auto",
	"square": "aspect-square object-cover",
	"video": "aspect-video object-cover",
};

const safeAlt = alt || `Image ${width}x${height}`;

const responsiveSizes =
	sizes ||
	(responsive
		? `(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${width || "100%"}`
		: undefined);

const responsiveWidths = responsive ? [240, 540, 720, width] : undefined;
---

<div class:list={["rounded-cta overflow-clip", className]}>
	<AstroImage
		alt={safeAlt}
		class:list={[
			"object-cover transition-opacity duration-300",
			aspectRatios[aspectRatio],
			className,
		]}
		height={src?.height}
		layout={layout}
		loading={loading}
		quality={quality}
		sizes={responsiveSizes}
		src={src || fallback}
		width={src?.width}
		widths={responsiveWidths}
	/>
</div>
