---
import type { CollectionEntry } from "astro:content";
import type { TCollection } from "@lib/utils/types";
import Img from "@components/ui/Img.astro";
import globalConfig from "@lib/config";
import Icon from "@components/ui/Icon.astro";
import ImageLoader from "@components/ui/ImageLoader.astro";

const { formatDate, setHref } = globalConfig.utils ?? {};

type Props = {
	aspect?: "auto" | "square" | "video";
	entry: CollectionEntry<TCollection> | undefined;
	href?: string;
	size?: "sm" | "md" | "lg";
};

const { aspect = "video", entry, href, size = "lg" } = Astro.props;
const aspectRatio = { auto: "", square: "aspect-square", video: "aspect-video" };
const compact = size === "sm" || size === "md";

const TextSize = size === "sm" ? "small" : "strong";
---

<div
	class:list={[
		"relative flex w-full flex-col gap-4",
		"hover:[&_.thumbnail_img]:scale-105",
		compact && "border-outline h-full overflow-clip border",
		size === "sm"
			? "rounded-cta hover:[&_.thumbnail_img]:-rotate-1"
			: "rounded-element hover:[&_.thumbnail_img]:rotate-[-0.5deg]",
	]}
>
	<div class="rounded-pill bg-blur-primary absolute right-0 z-10 m-2 p-2">
		<Icon class="h-4 w-4" name={entry?.collection || "at-sign"} />
	</div>
	<div
		class:list={[
			"flex overflow-clip",
			size === "lg" && ["relative", aspectRatio[aspect]],
			compact ? "absolute inset-0" : "rounded-element border-outline border",
			,
		]}
	>
		<ImageLoader aspect="auto" />
		<Img
			class:list={[
				"thumbnail relative h-full w-full ease-in-out [&_img]:transition-(--easing)",
			]}
			src={entry?.data.thumbnail}
		/>
	</div>
	<div class:list={["flex flex-col gap-1", compact && "flex h-full"]}>
		<a
			class:list={["w-fit hover:underline", "after:absolute after:inset-0"]}
			href={href || setHref(entry, entry)}
		>
			<TextSize
				class:list={[
					TextSize === "small" && "font-bold",
					compact && "absolute bottom-0 w-full border-t p-4 text-neutral-50",
					compact && entry?.collection === "tools" && "border-yellow-500 bg-yellow-600",
					compact && entry?.collection === "streams" && "border-pink-500 bg-pink-600",
					compact && entry?.collection === "models" && "border-purple-500 bg-purple-600",
					compact && entry?.collection === "resources" && "border-sky-500 bg-sky-600",
				]}
			>
				{entry?.data.title}
			</TextSize>
		</a>
		{
			size === "lg" && (
				<small class="opacity-50">
					{formatDate(entry?.data.dateCreated || new Date())}
				</small>
			)
		}
	</div>
</div>
