---
import DonateButton from "@/ui/DonateButton.astro";
import { SOCIAL_LINK } from "@/scripts/constants";
import KofiQR from "./ui/KofiQR.astro";
import Button from "./ui/Button.astro";

const { kofi } = SOCIAL_LINK;
---
<div class="kofi-card">
    <DonateButton size="100%"/>
    <a class="kofi-qr" href={kofi.href}>
        <KofiQR color="currentColor" background="var(--bg)" />
        <img src="/images/kofi-mug.gif" alt="Ko-fi mug icon">
    </a>
</div>

<script is:inline>
	document.querySelector('.kofi-qr')?.addEventListener('click', function() {
		window.posthog?.capture('kofi_qr_clicked');
	});
</script>

<style>
    .kofi-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .kofi-qr {
        --bg: var(--bg-light);
        --color: var(--text);

        position: relative;
        overflow: clip;

        border: var(--border);
        border-radius: var(--radius-sm);
        background: var(--bg);
        color: var(--color);

        img {
            position: absolute;
            inset: 0;

            margin: auto;
            width: 96px;

            transition: all 0.4s cubic-bezier(0.68, -0.6, 0.32, 1.6);
        }

        &:hover, &:focus {
            --color: var(--text-hover);
            --bg: var(--bg-hover);

            img {
                scale: 2.5;
                rotate: -15deg;
            }
        }
    }
</style>