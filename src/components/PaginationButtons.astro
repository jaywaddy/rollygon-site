---
import type { TEntry } from "@lib/utils/types";
import Button from "./ui/Button.astro";
import globalConfig from "@lib/config";

type Props = { data: TEntry; label?: string };

const { data, label } = Astro.props;
const { getProjectID } = globalConfig.utils;
---

<div class="flex gap-2">
	{
		data.current.collection === "streams" ? (
			<>
				<Button
					href={getProjectID(data?.prev, "path")}
					label={label ? `Prev ${label}` : "Prev"}
					icon="arrow-left"
					varient="outline"
					disabled={data?.prev === undefined}
				/>
				<Button
					href={getProjectID(data?.next, "path")}
					label={label ? `Next ${label}` : "Next"}
					icon={["arrow-right", "right"]}
					varient="outline"
					disabled={data?.next === undefined}
				/>
			</>
		) : (
			<>
				<Button
					href={getProjectID(data?.globalPrev)}
					label={label ? `Prev ${label}` : "Prev"}
					icon="arrow-left"
					varient="outline"
					disabled={data?.globalPrev === undefined}
				/>
				<Button
					href={getProjectID(data?.globalNext)}
					label={label ? `Next ${label}` : "Next"}
					icon={["arrow-right", "right"]}
					varient="outline"
					disabled={data?.globalNext === undefined}
				/>
			</>
		)
	}
</div>
