---
import type { TCollection, TCta } from "@lib/utils/types";
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
import globalConfig from "@lib/config";
import type { CollectionEntry } from "astro:content";

const { capitalize, findContent, getProjectID, setWarning } = globalConfig.utils ?? {};

if (!globalConfig) {
	setWarning("Bread Crumbs", "globalConfig");
	return null;
}

type Props = { entry?: CollectionEntry<TCollection>; path: string; title: string | undefined };

const { entry, path, title } = Astro.props ?? {};

const crumbs = path.split("/");
const lastCrumb = crumbs.length - 1;

const crumbList: TCta[] = crumbs.map((_crumb, _index) => {
	const setHref = () => {
		if (_index > 0 && _index < crumbs.length) {
			return crumbs.slice(0, _index + 1).join("/");
		}

		return "/";
	};

	const setLabel = () => {
		const root = crumbs[1];
		const getCollectionFromPath = function (path: string) {
			if (
				path === "models" ||
				path === "resources" ||
				path === "streams" ||
				path === "tools"
			) {
				return findContent(path, _crumb)?.data.title;
			}

			return "";
		};

		switch (_index) {
			case 0:
				return "Home";
			case 2:
				return getCollectionFromPath(root);
			case lastCrumb:
				return title;
			default:
				if (entry && entry.collection === "streams" && _crumb === getProjectID(entry)) {
					return findContent(entry.data.collection, getProjectID(entry))?.data.title;
				}

				return capitalize(_crumb);
		}
	};

	return {
		href: setHref(),
		label: _crumb === "" ? globalConfig.brand?.name : setLabel(),
		icon: _index === 0 ? "home" : undefined,
		varient: "ghost",
		iconOnly: _index === 0,
	};
});
---

<ul class="flex scrollbar-gutter-auto items-center overflow-auto lg:gap-2">
	{
		crumbList.map((crumb, index) => (
			<>
				{index > 0 && (
					<li>
						<Icon class="text-50 w-4" name="chevron-right" />
					</li>
				)}
				<li
					class:list={[
						"max-md:[&_.bcrumb]:p-[0.5px_1px] max-md:[&_.bcrumb]:text-xs max-md:[&_.bcrumb]:[&_svg]:w-3",
					]}
				>
					<Button
						class:list={[
							"bcrumb w-fit",
							index !== lastCrumb && "text-50 hover:text-100",
							index !== 0 && index !== lastCrumb && "max-md:hidden md:flex",
						]}
						{...crumb}
					/>
					{index !== 0 && index !== lastCrumb && (
						<Button
							class:list={[
								"bcrumb w-fit",
								index !== lastCrumb && "text-50 hover:text-100",
								"max-md:flex md:hidden",
							]}
							{...crumb}
							label={"..."}
						/>
					)}
				</li>
			</>
		))
	}
</ul>
