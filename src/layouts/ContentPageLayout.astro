---
import ContentNavigation from "@/components/ContentNavigation.astro";
import AssetPoster from "@/components/ui/AssetPoster.astro";
import SideBar from "@/components/SideBar.astro";

import { calcReadTime, formatDate, setImageSrc } from "@/scripts/utilities";
import type { Collection } from "@/content.config";
import Button from "@/components/ui/Button.astro";
import TableOfContents from "@/components/ui/TableOfContents.astro";
import { render } from "astro:content";

interface Props {
	content: Collection;
	contentCollection: Array<Collection>;
	index: number;
}

const { content, contentCollection, index } = Astro.props;
const { title, description, postDate, modifiedDate } = content.data;
const { collection, body } = content;
const { headings } = await render(content);

function setButtonLabel(price: string): string {
	if (collection === "tools" && content.data.price === "$0+") {
		return "Download tool"
	}

	return `Buy tool`
}
---

<div class="column-lg">
	<div class="asset-poster column-md">
		<ContentNavigation {content} {contentCollection} {index} />
		<AssetPoster {content} />
	</div>
	<div class="main-body row-lg">
		<section id="main-content" class="column-lg">
			<div class="column-md content-wrapper">
				<h1>{title}</h1>
				<p>{description}</p>
				<div class="column-md">
					{collection === "posts" && (
						<small>
							<strong>{formatDate(postDate)}</strong>
							<span>&bullet;</span>
							<strong>{calcReadTime(body)} min read</strong>
						</small>
					)}

					{ modifiedDate && (
						<small>
							<em>Last updated:</em>
							<em>{formatDate(modifiedDate)}</em>
						</small>
					)}

					{collection === "tools" && (
						<small>
							<strong>{formatDate(postDate)}</strong>
							<span>&bullet;</span>
							<strong>{content.data.version}</strong>
						</small>
						<Button
							label={`Get tool`}
							price={content.data.price}
							icon="download"
							href={content.data.href}
							primary
						/>
					)}

					{collection === "models" && (
						<small>
							<strong>{formatDate(postDate)}</strong>
							<span>&bullet;</span>
							<strong>{content.data.size}</strong>
						</small>
					)}
				</div>
			</div>
			{headings.length > 0 && (
				<div data-layout="mobile">
					<TableOfContents {headings} />
				</div>
			)}
			<article class="content">
				<slot />
			</article>
		</section>
		<SideBar {headings} {content} />
	</div>
</div>

<style>
	.main-body {
		display: flex;
		justify-content: space-between;
	}

	#main-content {
		padding: var(--padding-lg);

		border-radius: var(--radius-sm);
		border: var(--border);
		background: var(--bg-light);
	}

	.asset-poster {
		position:  relative;
	}

	.programs {
		position: absolute;
		inset: 0;
	}

	.logo {
		width: 64px;
	}
</style>