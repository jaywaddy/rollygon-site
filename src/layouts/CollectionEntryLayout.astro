---
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import Image from "@components/ui/Img.astro";
import { render } from "astro:content";
import TableOfContents from "@components/TableOfContents.astro";
import ContactLinks from "@components/ContactLinks.astro";
import globalConfig from "@lib/config";
import YouTubeEmbed from "@components/YouTubeEmbed.astro";
import SketchfabEmbed from "@components/SketchfabEmbed.astro";
import Button from "@components/ui/Button.astro";
import Fallback from "@assets/fallback.png";
import CardGalleryEntry from "@components/CardGalleryEntry.astro";
import Icon from "@components/ui/Icon.astro";
import { modelsCollection, toolsCollection } from "@src/content.config";
import DynamicTitleSection from "@components/DynamicTitleSection.astro";
import CardBlogPost from "@components/CardBlogPost.astro";
import type { TEntry } from "@lib/utils/types";
import PaginationButtons from "@components/PaginationButtons.astro";

const { capitalize, findContent, findStream, getProjectID, setStreamTitle } = globalConfig.utils;

type Props = { entry: TEntry; metaTitle?: string; title?: string };

const { entry, metaTitle, title: entryTitle } = Astro.props;
const { Content, headings } = await render(entry.current);
const { sketchfabUrl, title, thumbnail = Fallback, youtubeUrl } = entry.current.data;

const isModel = entry.current.collection === "models";
const isStream = entry.current.collection === "streams";
const isTool = entry.current.collection === "tools";
const singleEntry =
	entry.globalPrev !== entry.current
		? entry.globalNewest === entry.current && !entry.globalPrev?.id
		: entry.newest === entry.current && !entry.prev?.id;
---

<GlobalLayout {entry} {...entry.current.data} body={entry.current.body} {metaTitle} {thumbnail}>
	<GlobalGrid>
		<Container class="relative" layout="content">
			<div class="rounded-pill bg-blur-primary absolute right-0 z-10 m-2 p-2">
				<Icon class="h-4 w-4" name={entry.current.collection} />
			</div>
			<div class:list={["relative"]}>
				{
					sketchfabUrl && isModel ? (
						<SketchfabEmbed {title} url={sketchfabUrl} />
					) : youtubeUrl ? (
						<YouTubeEmbed url={youtubeUrl} />
					) : (
						<div class="rounded-element flex max-h-96 items-center overflow-clip">
							<Image class="w-full" src={thumbnail} />
						</div>
					)
				}
			</div>
		</Container>
	</GlobalGrid>
	<GlobalGrid class="lg:mt-8">
		<Container class="flex flex-col gap-8 lg:pr-12" layout="sidebar">
			<div class:list={["sticky top-(--scroll-p) grid gap-8"]}>
				<TableOfContents headings={[...headings]} />
				{
					!singleEntry &&
						(entry.current.collection === "streams" ? (
							entry.next ? (
								<div class="flex w-full flex-col gap-2 max-lg:h-64 lg:aspect-square">
									<span class="eyebrow">Next {entry.next.data.singular}</span>
									<div class="relative h-full">
										{isStream && (
											<span class="bg-blur-primary rounded-pill absolute inset-0 z-10 m-2 flex h-8 w-fit items-center justify-center px-4">
												Stream #
												{Number(
													getProjectID(entry.next, "path"),
												).toLocaleString()}
											</span>
										)}
										<CardGalleryEntry entry={entry.next} size="md" />
									</div>
								</div>
							) : (
								entry.collection[1] && (
									<div class="flex w-full flex-col gap-2 max-lg:h-64 lg:aspect-square">
										<span class="eyebrow">
											First {entry.current.data.singular}
										</span>
										<div class="relative h-full">
											{isStream && entry.newest && (
												<span class="bg-blur-primary rounded-pill absolute inset-0 z-10 m-2 flex h-8 w-fit items-center justify-center px-4">
													Stream #
													{Number(
														getProjectID(entry.oldest, "path"),
													).toLocaleString()}
												</span>
											)}
											<CardGalleryEntry entry={entry.oldest} size="md" />
										</div>
									</div>
								)
							)
						) : entry.globalNext ? (
							<div class="flex w-full flex-col gap-2 max-lg:h-64 lg:aspect-square">
								<span class="eyebrow">Next {entry.globalNext.data.singular}</span>
								<div class="relative h-full">
									{isStream && (
										<span class="bg-blur-primary rounded-pill absolute inset-0 z-10 m-2 flex h-8 w-fit items-center justify-center px-4">
											Stream #
											{Number(
												getProjectID(entry.globalNext),
											).toLocaleString()}
										</span>
									)}
									<CardGalleryEntry entry={entry.globalNext} size="md" />
								</div>
							</div>
						) : (
							<div class="flex w-full flex-col gap-2 max-lg:h-64 lg:aspect-square">
								<span class="eyebrow">
									First {entry.globalOldest?.data.singular}
								</span>
								<div class="relative h-full">
									{isStream && entry.newest && (
										<span class="bg-blur-primary rounded-pill absolute inset-0 z-10 m-2 flex h-8 w-fit items-center justify-center px-4">
											Stream #
											{Number(
												getProjectID(entry.globalOldest),
											).toLocaleString()}
										</span>
									)}
									<CardGalleryEntry entry={entry.globalOldest} size="md" />
								</div>
							</div>
						))
				}
				<ContactLinks groups={["socialLinks"]} />
			</div>
		</Container>
		<Container class="flex flex-col gap-8 max-lg:mt-8" layout="article" tag="article">
			<DynamicTitleSection entry={entry.current} title={entryTitle} />
			<div class="flex flex-col gap-16 last-of-type:[div]:gap-8">
				{
					entry.current.data.models && (
						<div class="flex flex-col gap-8">
							<span class="eyebrow">
								{isStream
									? "Model Built on Stream"
									: `${capitalize(entry.current.data.singular)} Demo`}
							</span>
							<SketchfabEmbed
								{title}
								url={
									findContent("models", entry.current.data.models[0])?.data
										.sketchfabUrl
								}
							/>
						</div>
					)
				}
				{
					entry.current.body && (
						<article class="content">
							<Content />
						</article>
					)
				}
				{
					isModel && entry.current.data.tools && (
						<div class="flex flex-col gap-4">
							<span class="eyebrow">Tools Used</span>
							<ul class="grid grid-cols-3 gap-2 max-sm:grid-cols-2">
								{entry.current.data.tools.map((tool) => (
									<li class="aspect-square">
										<CardGalleryEntry
											entry={toolsCollection.find(
												(content) =>
													getProjectID(content) === tool.replace("&", ""),
											)}
											size="sm"
										/>
									</li>
								))}
							</ul>
						</div>
					)
				}
				{
					entry.current.collection === "tools" && (
						<Button
							href={entry.current.data.downloadLink}
							label={
								entry.current.data.price
									? `$${entry.current.data.price.toLocaleString()}`
									: "Free Download"
							}
							icon="download"
							varient={["primary", "lg"]}
						/>
					)
				}
				{
					isTool && (
						<div class="flex flex-col gap-4">
							<span class="eyebrow">Models Built Using this Tool</span>
							<ul class="grid grid-cols-3 gap-2 max-sm:grid-cols-2">
								{entry.current.data.models?.map((model) => (
									<li class="aspect-square">
										<CardGalleryEntry
											entry={modelsCollection.find(
												(content) =>
													content.id.split("/")[0] ===
													model.replace("&", ""),
											)}
											size="sm"
										/>
									</li>
								))}
							</ul>
						</div>
					)
				}
				{
					!isStream && findContent("streams", getProjectID(entry.current)) && (
						<div class="flex flex-col gap-4">
							<span class="eyebrow">Live Streams</span>
							<ul class="flex flex-col gap-4">
								{findStream(getProjectID(entry.current)).map((stream) => (
									<li>
										<CardBlogPost
											entry={stream}
											label={setStreamTitle(stream)}
										/>
									</li>
								))}
							</ul>
						</div>
					)
				}
				{
					entry && (
						<div class="flex justify-end border-30 border-t border-dashed pt-8">
							<PaginationButtons data={entry} />
						</div>
					)
				}
			</div>
		</Container>
	</GlobalGrid>
</GlobalLayout>
