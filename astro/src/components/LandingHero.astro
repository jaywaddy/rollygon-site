---
import AssetCard from "./AssetCard.astro";
import Container from "../layouts/Container.astro";
import Cta from "./ui/Cta.astro";
import GlobalGrid from "../layouts/GlobalGrid.astro";
import Icon from "./ui/Icon.astro";
import type { TLandingPage } from "../lib/schema/landingPage";

type Props = { data: TLandingPage };

const { data } = Astro.props;
const { cta_buttons, featured_tool, hero_subtitle, hero_title } = data ?? {};
---

<GlobalGrid class="site-grid py-48">
    <Container layout="content" class="flex items-center justify-between">
        <div class="flex w-xl flex-col gap-4">
            <h1 class="hero">{hero_title}</h1>
            <p class="lead">{hero_subtitle}</p>
            <div class="flex gap-2">
                {cta_buttons?.map((cta) => <Cta data={cta} />)}
            </div>
        </div>
        <div class="flex flex-col gap-4">
            <small class="eyebrow"><Icon name="new" />Latest Tool</small>
            <AssetCard data={featured_tool} />
        </div>
    </Container>
</GlobalGrid>
