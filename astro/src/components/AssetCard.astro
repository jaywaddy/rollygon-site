---
import type { TAsset } from "../lib/schema";
import { getTool } from "../lib/schema/tools";
import Image from "./Image.astro";

type Props = { data: TAsset };

const { data } = Astro.props;

if (!data) {
    console.warn("Asset Card: data prop is either missing or invalid.");
    return null;
}

const { collection, key } = data ?? {};
const { title, featured_image, description, legacy_date_created, date_created, price } =
    (await getTool(key)) ?? {};

const getDate = () => {
    return new Date(legacy_date_created || date_created).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};
---

<section
    class="rounded-element relative flex h-122 max-w-96 flex-col gap-4 overflow-clip p-6 text-zinc-50"
>
    <Image class="absolute inset-0 h-full" src={featured_image} />
    {
        "price" in data && (
            <span class="button button-sm button-primary">{data.price === 0 && "FREE"}</span>
        )
    }
    <div
        style="--gradient: var(--card-gradient);--color: var(--color-brand-950);"
        class="asset-gradient b bg-brand-900 absolute inset-0 content-['']"
    >
    </div>
    <div class="z-10 mt-auto">
        <div class="flex flex-col gap-1">
            {
                collection === "tools" && (
                    <small class="rounded-cta bg-brand-500 text-cta-primary-text mb-4 w-fit px-2 py-1 font-bold uppercase">
                        {price ? `$${price}` : "Free"}
                    </small>
                )
            }
            <!-- {
                collection === "models" && (
                    <div class="opacity-60">
                        <span>{verts}</span>
                        <span>{tris}</span>
                        <span>{quads}</span>
                    </div>
                )
            } -->
            <a href="">
                <h3>{title}</h3>
            </a>
            <p class="lead">{description}</p>
            <div class="flex gap-2">
                <span>{getDate()}</span>
                <span>&bullet;</span>
                <span>file size...</span>
            </div>
        </div>
    </div>
</section>
