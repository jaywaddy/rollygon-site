---
import { type TCategory } from "../lib/schema/resources";
import Element from "./Element.astro";
import Image from "./Image.astro";
import Badge from "./ui/Badge.astro";
import type { TIconName } from "./ui/Icon.astro";
import Seperator from "./ui/Seperator.astro";

type TBadge = { icon: TIconName; label: string };
type Props = { class?: string; data: any; imageOff?: boolean };

const { class: className, data, imageOff } = Astro.props;

if (!data) {
    console.warn("TextCard: data property is either missing or invalid.");
    return null;
}

const { categories, description, featured_image, slug, title } = data ?? {};

const badges = (): TBadge[] => {
    if (categories) {
        return categories.map((category: TCategory) => {
            return { icon: category, label: category };
        });
    }

    return [];
};
---

<section
    class:list={[
        "bg-primary rounded-element relative flex min-h-36 flex-row items-center overflow-clip",
        className,
    ]}
>
    {!imageOff && <Image class:list={"aspect-square h-36"} src={featured_image} />}

    <div class:list={["z-10 w-full pl-8"]}>
        <div class="flex max-w-2xl flex-col">
            <a href="">
                <h3>{title}</h3>
            </a>
            {description && <p>{description}</p>}
            <div class="z-10 mt-2 flex items-center gap-4">
                {
                    badges().map((badge: TBadge, index: number) =>
                        index < badges().length - 1 ? (
                            <>
                                <Badge {badge} />
                                <Seperator />
                            </>
                        ) : (
                            <Badge {badge} />
                        ),
                    )
                }
            </div>
        </div>
    </div>
</section>
