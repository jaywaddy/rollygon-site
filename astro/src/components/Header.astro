---
import type { THeader } from "../types";
import StrapiImage from "./StrapiImage.astro";
import Link from "./ui/Link.astro";

interface Props {
    data: THeader | undefined;
    class?: string;
}

const { data: header } = Astro.props;

if (!header) return null;

const currentPath = Astro.url.pathname;
---

<header class="flex justify-between bg-neutral-500">
    <div class="w-42">
        <a href={header.logo.href}>
            <StrapiImage
                src={header.logo.image?.url}
                alt={header.logo.image?.alternativeText}
                width={100}
                height={32}
            />
        </a>
    </div>
    <div class="flex items-center gap-8">
        <nav class="flex items-center">
            <ul class="flex items-center gap-4">
                {
                    header.navLinks.map((link) => (
                        <li>
                            <Link data={link} />
                        </li>
                    ))
                }
            </ul>
        </nav>
        <Link data={header.cta} />
    </div>
</header>
