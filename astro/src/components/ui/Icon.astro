---
import {
    ArrowDown,
    ArrowLeft,
    ArrowRight,
    ArrowUp,
    Box,
    ChevronDown,
    ChevronLeft,
    ChevronRight,
    ChevronUp,
    CircleDot,
    Download,
    ExternalLink,
    Forward,
    Hammer,
    Menu,
    Moon,
    Pyramid,
    Search,
    Sparkles,
    Sun,
    SunMoon,
    X,
} from "@lucide/astro";

const iconMap = {
    "arrow-down": ArrowDown,
    "arrow-left": ArrowLeft,
    "arrow-right": ArrowRight,
    "arrow-up": ArrowUp,
    "close": X,
    "chevron-down": ChevronDown,
    "chevron-left": ChevronLeft,
    "chevron-right": ChevronRight,
    "chevron-up": ChevronUp,
    "download": Download,
    "external-link": ExternalLink,
    "menu": Menu,
    "new": Sparkles,
    "quads": Box,
    "search": Search,
    "send": Forward,
    "theme": SunMoon,
    "theme-dark": Moon,
    "theme-light": Sun,
    "tool": Hammer,
    "tris": Pyramid,
    "verts": CircleDot,
};

export type TIconName = keyof typeof iconMap;
type Props = { name: TIconName };

const { name } = Astro.props;

if (!name) return null;

const Icon = iconMap[name] ?? Fragment;
---

<Icon />
