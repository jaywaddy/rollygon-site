---
import Icon, { type TIconName } from "./Icon.astro";

type Props = { class?: string; badge?: TBadge };
export type TBadge = { icon: TIconName; label: string };

const { class: className, badge } = Astro.props;

if (!badge) {
    console.warn("Badge: badge property is either missing or invalid.");
    return null;
}

const { icon, label } = badge ?? {};
---

<div class:list={["badge flex gap-1.5", className]}>
    <Icon name={icon} />
    <span>{label}</span>
</div>
