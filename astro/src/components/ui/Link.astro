---
import type { TCta } from "../../lib/schema";
import Icon, { type TIconName } from "./Icon.astro";

type TButtonSize = "sm" | "md" | "lg" | "none";
type TButtonStyle = "primary" | "secondary";
type TIconPosition = "left" | "right";
type TOutline = "none" | "outline";

type Props = {
    arriaCurrent?: "page" | undefined;
    button?: [TButtonSize, TButtonStyle?, TOutline?];
    class?: string;
    data: TCta;
    icon?: [TIconName, TIconPosition?];
    iconOnly?: boolean;
    isExternal?: boolean;
    isUnderlined?: boolean;
};

const {
    arriaCurrent,
    button = ["none", "primary", "none"],
    class: classAttribute,
    data: link,
    icon = ["none", "left"],
    iconOnly = false,
    isExternal,
    isUnderlined,
} = Astro.props;

if (!link || link === undefined) {
    console.warn("Link: data property is invalid.");
    return null;
}

const buttonSize = button[0];
const buttonStyle = button[1];
const buttonOutline = button[2];
const iconName = icon[0];
const iconPosition = icon[1];
const targetAttribute = isExternal ? "_blank" : undefined;

const setButtonSize = function (): string {
    const buttonSizes = new Map<string, string>([
        ["sm", "px-2 pb-0.5 text-sm"],
        ["md", "px-2 py-1"],
        ["lg", "px-4 py-2"],
    ]);

    return buttonSizes.get(buttonSize) || "";
};

const setButtonStyle = function (): string {
    const buttonStyles = new Map<string, string>([
        [
            "primary",
            `bg-cta-primary text-cta-primary-text
            hover:bg-cta-primary-hover focus:bg-cta-primary-hover
            `,
        ],
        [
            "secondary",
            `bg-cta-secondary text-cta-secondary-text
            hover:bg-cta-secondary-hover focus:bg-cta-secondary-hover
            ${buttonOutline === "outline" && "outline outline-current"}`,
        ],
    ]);

    return buttonStyles.get(buttonStyle || "primary") || "";
};

const setIconStroke = function (): string {
    const iconStrokes = new Map<string, string>([
        ["sm", "[&_path]:stroke-[2px]"],
        ["md", "[&_path]:stroke-[2.5px]"],
        ["lg", "font-[500] [&_path]:stroke-[2.8px]"],
    ]);

    return iconStrokes.get(buttonSize) || "";
};

const styles = {
    default: "relative flex w-fit items-center gap-1 rounded-cta text-nowrap [&_svg]:h-4",
    link: "hover:bg-link-hover focus:bg-link-hover px-3 py-1.5",
    button: `font-[450] ${setButtonSize()} ${setButtonStyle()} ${buttonOutline === "outline" && "outline outline-text-hover"}`,
    underlined: "underline",
    iconLeft: "flex-row",
    iconRight: "flex-row-reverse",
};
---

<a
    href={link.href}
    target={targetAttribute}
    class:list={[
        styles.default,
        classAttribute,
        isUnderlined && styles.underlined,
        iconPosition === "right" ? styles.iconRight : styles.iconLeft,
        buttonSize === "none" ? styles.link : styles.button,
    ]}
    aria-current={arriaCurrent}
>
    {
        iconName !== "none" && (
            <span
                class:list={[
                    `text-current ${setIconStroke()}`,
                    buttonSize === "sm" && "[&_svg]:w-3",
                ]}
            >
                <Icon name={iconName} />
            </span>
        )
    }
    {!iconOnly && (buttonSize === "sm" ? <small>{link.label}</small> : link.label)}
</a>
