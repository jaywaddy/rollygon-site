---
import type { TCta } from "../../lib/schema";

type Props = {
    arriaCurrent?: "page" | undefined;
    button?: { size: "sm" | "md" | "lg"; style: "primary" | "secondary" };
    class?: string;
    data: TCta;
    iconRight?: boolean;
    isExternal?: boolean;
    isUnderlined?: boolean;
};

const {
    arriaCurrent,
    button,
    class: classAttribute,
    data: link,
    iconRight,
    isExternal,
    isUnderlined,
} = Astro.props;

if (!link || link === undefined) {
    console.warn("Link: data property is invalid.");
    return null;
}

const targetAttribute = isExternal ? "_blank" : undefined;

const setButtonSize = function (): string {
    const buttonSizes = new Map<string, string>([
        ["sm", "button-sm"],
        ["md", "button-md"],
        ["lg", "button-lg"],
    ]);

    return buttonSizes.get(button?.size || "") || "";
};

const setButtonStyle = function (): string {
    const buttonSizes = new Map<string, string>([
        ["primary", "button-primary"],
        ["secondary", "button-secondary"],
    ]);

    return buttonSizes.get(button?.style || "") || "";
};
---

<a
    href={link.href}
    target={targetAttribute}
    class:list={[
        "flex w-fit items-center gap-1 [&_svg]:h-4",
        iconRight ? "flex-row-reverse" : "flex-row",
        isUnderlined ? "underline" : "",
        typeof button === "object" && `button ${setButtonSize()} ${setButtonStyle()}`,
        typeof button !== "object" && !arriaCurrent && "cta-hover",
        classAttribute,
    ]}
    aria-current={arriaCurrent}
>
    {link.label}
</a>
