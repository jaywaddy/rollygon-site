---
import type { TLink } from "../../types";
import StrapiImage from "../StrapiImage.astro";
import { componentStyles as style } from "../_componentStyles";

interface Props {
    data: TLink;
    isActive?: "page" | "false";
}

const { data: link, isActive = "false" } = Astro.props;

if (!link) return null;

const imagePositionStyles = link.imageOnRight ? "flex-row-reverse" : "flex-row";
const isUnderlinedStyles = link.isUnderlined ? "underline" : "";
---

<a
    href={link.href}
    class:list={[
        style.link,
        imagePositionStyles,
        isUnderlinedStyles,
        link.isButtonLink && style.button,
    ]}
    aria-current={isActive}
>
    {
        link.image && (
            <StrapiImage
                src={link.image?.url}
                alt={link.image?.alternativeText}
                width={link.image?.width}
                height={link.image?.height}
            />
        )
    }
    {link.label}
</a>
