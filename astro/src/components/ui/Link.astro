---
import type { TLink } from "../../types";
import StrapiImage from "../StrapiImage.astro";

type Props = { data: TLink; class?: string; arriaCurrent?: "page" | undefined };

const { data: link, class: classAttribute, arriaCurrent } = Astro.props;

if (!link) {
    console.warn("Link: data property is invalid.");
    return null;
}

const targetAttribute = link.isExternal ? "_blank" : undefined;

const setButtonSize = function (): string {
    const buttonSizes = new Map<string, string>([
        ["SMALL", "button-sm"],
        ["MEDIUM", "button-md"],
        ["LARGE", "button-lg"],
    ]);

    return buttonSizes.get(link.buttonSize) || "";
};

const setButtonStyle = function (): string {
    const buttonSizes = new Map<string, string>([
        ["PRIMARY", "button-primary"],
        ["SECONDARY", "button-secondary"],
    ]);

    return buttonSizes.get(link.buttonStyle) || "";
};
---

<a
    href={link.href}
    target={targetAttribute}
    class:list={[
        "flex w-fit items-center gap-1",
        link.imageOnRight ? "flex-row-reverse" : "flex-row",
        link.isUnderlined ? "underline" : "",
        link.isButtonLink && `button ${setButtonSize()} ${setButtonStyle()}`,
        !link.isButtonLink && !arriaCurrent && "cta-hover",
        classAttribute,
    ]}
    aria-current={arriaCurrent}
>
    {
        link.image && (
            <StrapiImage
                src={link.image?.url}
                alt={link.image?.alternativeText}
                width={link.image?.width}
                height={link.image?.height}
            />
        )
    }
    {link.label}
</a>
