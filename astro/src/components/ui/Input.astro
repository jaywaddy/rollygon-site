---
import type { TInputFieldType } from "../../lib/schema";

type Props = {
    id: string;
    name?: string;
    label?: string;
    class?: string;
    type?: TInputFieldType;
    placeholder?: string;
    required?: boolean;
};

const { id, name, label, class: className, placeholder, required, type } = Astro.props;
---

{
    label && (
        <label class="flex flex-col gap-2" for={id}>
            <small>
                {label}
                {required && <span class="text-error">*</span>}
            </small>
        </label>
    )
}
{
    type === "textarea" ? (
        <textarea
            class:list={[
                "bg-secondary rounded-cta w-full resize-none px-4 py-2 placeholder:opacity-50",
                className,
            ]}
            {id}
            {name}
            {placeholder}
            rows="6"
            maxlength={1000}
            {required}
        />
    ) : (
        <input
            {id}
            class:list={[
                "bg-secondary rounded-cta w-full px-4 py-2 placeholder:opacity-50",
                className,
            ]}
            type="text"
            {name}
            {placeholder}
            {required}
        />
    )
}
