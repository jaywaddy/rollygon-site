---
import Link from "@components/ui/Link.astro";
import type { TCta, TDisplay } from "../../lib/schema";

type Props = { data: { description?: string; cta: TCta; display: TDisplay } };

const { data: banner } = Astro.props;

if (banner.display === "hidden") {
    return null;
}
---

<div id="banner" class="bg-primary site-grid relative py-2">
    <div class="grid-span-body flex items-center justify-between">
        <div class="mx-auto flex items-center gap-2">
            <small class="flex gap-2">
                <span>{banner.description}</span>
                <span>&mdash;</span>
            </small>
            <Link data={banner.cta} button={["sm", "primary"]} icon={["tool"]} />
        </div>
        <button id="dismiss-button" class="cta-hover cursor-pointer justify-end border-none">
            &#x2715;
        </button>
    </div>
</div>
<script>
    const banner = document.getElementById("banner");
    const dismissButton = document.getElementById("dismiss-button");

    if (banner && dismissButton) {
        dismissButton.addEventListener("click", () => {
            banner.style.display = "none";
        });
    }
</script>
