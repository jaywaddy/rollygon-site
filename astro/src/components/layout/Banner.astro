---
import Cta from "@components/ui/Cta.astro";
import type { TGlobalData } from "../../lib/schema/globalData";
import type { TCta, TDisplay } from "../../lib/schema";
import Container from "../../layouts/Container.astro";
import GlobalGrid from "../../layouts/GlobalGrid.astro";

type Props = { data: TGlobalData };
type TBanner = { description: string; cta: TCta; display: TDisplay };

const { data } = Astro.props;

if (!data) {
    console.error("Failed to fetch global data.");
    return null;
}

const { banner_description, banner_cta, banner_display } = data ?? {};

const banner: TBanner = {
    description: banner_description,
    cta: banner_cta[0],
    display: banner_display,
};

if (banner.display === "hidden") {
    return null;
}
---

<GlobalGrid id="banner" class="bg-brand">
    <Container layout="body" class="text-cta-primary-text flex items-center justify-between py-1">
        <div class="mx-auto flex items-center gap-2">
            <small class="flex gap-2">
                <span class="text-nowrap">{banner.description}</span>
                <span>&mdash;</span>
            </small>
            <Cta data={banner.cta} style={["sm", "outline"]} icon={["new"]} />
        </div>
        <Cta
            id="dismiss-button"
            data={{ label: "Close banner" }}
            style={["md"]}
            icon={["close"]}
            iconOnly
        />
    </Container>
</GlobalGrid>
<script>
    const banner = document.getElementById("banner");
    const dismissButton = document.getElementById("dismiss-button");

    if (banner && dismissButton) {
        dismissButton.addEventListener("click", () => {
            banner.style.display = "none";
        });
    }
</script>
