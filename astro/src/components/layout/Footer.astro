---
import type { TFooter } from "../../types";
import Link from "../ui/Link.astro";

type Props = { data: TFooter | undefined };

const { data: footer } = Astro.props;

if (!footer) return null;
---

<div class="site-grid bg-ui-primary">
    <footer class="grid-span-body">
        <div class="border-outline border-b py-12"><Link data={footer.logo} /></div>
        <div class="grid grid-cols-5 gap-16 py-12">
            {
                footer.groups.map((group) => (
                    <ul class="flex flex-col gap-2">
                        <li class="bold pb-4 tracking-widest uppercase opacity-50">
                            <small>{group.title}</small>
                        </li>
                        {group.footerLinks.map((link) => (
                            <li class="">{<Link data={link} />}</li>
                        ))}
                    </ul>
                ))
            }
        </div>
    </footer>
    <small class="grid-span-screen flex justify-center bg-(--color-zinc-900) py-8 text-[white]">
        <span class="text-current">Copyright &copy;</span>
        <span id="footer-date" class="mr-1 text-current"></span>
        <span class="text-current">{footer.copyrightText}</span>
    </small>
</div>
<script>
    const footerDate = document.getElementById("footer-date");

    if (footerDate) {
        footerDate.innerHTML = new Date().getFullYear().toString();
    }
</script>
