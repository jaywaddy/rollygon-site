---
import Container from "../../layouts/Container.astro";
import GlobalGrid from "../../layouts/GlobalGrid.astro";

type Props = { class?: string };

const { class: className } = Astro.props;
---

<GlobalGrid>
    <div class="grid-span-left-gutter gutter-bg"></div>
    <Container layout="content" class:list={["flex flex-col gap-12", className]}>
        <slot />
    </Container>
    <div class="grid-span-right-gutter gutter-bg"></div>
</GlobalGrid>
