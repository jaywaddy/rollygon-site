---
import Container from "../../layouts/Container.astro";
import GlobalGrid from "../../layouts/GlobalGrid.astro";

type Props = { class?: string };

const { class: className } = Astro.props;
---

<GlobalGrid>
    <Container layout="left-gutter" class="gutter-bg" />
    <Container layout="content" class:list={["flex flex-col gap-12", className]}>
        <slot />
    </Container>
    <Container layout="right-gutter" class="gutter-bg" />
</GlobalGrid>
