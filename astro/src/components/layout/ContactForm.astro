---
import Input from "@components/ui/Input.astro";
import type { TGlobalData } from "../../lib/schema/globalData";
import type { TInputField } from "../../lib/schema";
import GlobalGrid from "../../layouts/GlobalGrid.astro";
import Container from "../../layouts/Container.astro";
import Icon from "@components/ui/Icon.astro";
import Element from "@components/Element.astro";

type Props = { data: TGlobalData | undefined };
type TContactForm = {
    title: string;
    body: string;
    inputFields: TInputField[];
    email: string;
    city: string;
};

const { data } = Astro.props;

if (!data) {
    console.warn("Contact Form: data is either missing or invalid.");
    return null;
}

const {
    contact_city,
    contact_email,
    contact_form_body,
    contact_form_input_fields,
    contact_form_title,
} = data ?? {};

const contactForm: TContactForm = {
    title: contact_form_title,
    body: contact_form_body,
    inputFields: contact_form_input_fields,
    email: contact_email,
    city: contact_city,
};
---

<GlobalGrid id="contact-form">
    <Container layout="article">
        <Element tag="section">
            <h2>{contactForm.title}</h2>
            <div set:html={contactForm.body} class="pb-4" />
            <form action="https://formsubmit.co/29c37eddc15bd59bcd6a93560581473e" method="POST">
                <input type="text" name="_honey" style="display:none" />
                <input type="hidden" name="_subject" value="New submission!" />
                <input type="hidden" name="_captcha" value="false" />
                <ul class="flex flex-col gap-4">
                    {
                        contactForm.inputFields.map(
                            ({ name, type, label, placeholder, required }) => (
                                <li>
                                    <Input
                                        id={name}
                                        {type}
                                        {label}
                                        {name}
                                        {placeholder}
                                        {required}
                                    />
                                </li>
                            ),
                        )
                    }
                </ul>
            </form>
        </Element>
    </Container>
    <Container layout="sidebar" class="card">
        <Element tag="aside">sidebar...</Element>
    </Container>
</GlobalGrid>
