---
import type { THeader, TLink } from "../../types";
import StrapiImage from "../StrapiImage.astro";
import Link from "../ui/Link.astro";

type Props = { data: THeader | undefined; class?: string };

const { data: header } = Astro.props;

if (!header) return null;

const currentPath = Astro.url.pathname;
const activeLink = header.navLinks.find((link) => link.href === currentPath);
const checkIsActive = (link: TLink) => link.href === activeLink?.href;
const navPosition = () => {
    switch (header.navPosition) {
        case "CENTER":
            return "mx-auto";
        case "RIGHT":
            return "ml-auto";
        default:
            return "mr-auto";
    }
};
---

<header id="header" class="site-grid bg-ui-secondary grid py-4 transition-[top] duration-300">
    <div class="grid-span-body flex gap-12">
        <Link data={header.logo} />
        <nav class:list={["flex items-center gap-12", navPosition()]}>
            <ul class="flex items-center gap-2">
                {
                    header.navLinks.map((link) => (
                        <li class={``}>
                            <Link
                                class:list={[
                                    "hover:bg-ui-primary ring-outline relative rounded-[0.325rem] px-4 leading-8 hover:ring",
                                    checkIsActive(link) && "bg-ui-primary ring",
                                ]}
                                data={link}
                            />
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div class="flex items-center justify-end gap-6">
            <li class="flex gap-1"><StrapiImage src="/uploads/sun_74d971071d.svg" />Light</li>

            <Link data={header.cta} />
        </div>
    </div>
</header>
<script>
    const header = document.querySelector("#header") as HTMLElement;
    let prevScrollPos = window.pageYOffset;

    if (header) {
        window.addEventListener("scroll", toggleHeader);
    }

    function toggleHeader() {
        let currentScrollPos = window.pageYOffset;

        prevScrollPos > currentScrollPos
            ? (header.style.top = "0")
            : (header.style.top = `-${header.scrollHeight}px`);
        prevScrollPos = currentScrollPos;
    }
</script>
