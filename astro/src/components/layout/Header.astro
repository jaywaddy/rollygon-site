---
import Image from "@components/Image.astro";
import type { TCta } from "../../lib/schema";
import type { TGlobalData } from "../../lib/schema/globalData";
import Link from "../ui/Link.astro";
import Icon from "@components/ui/Icon.astro";

type Props = { data: TGlobalData };
type THeader = { position: string; links: TCta[]; cta: TCta[]; logo: string };

const { data } = Astro.props;

if (!data) {
    console.error("Failed to fetch global data.");
    return null;
}

const { nav_position, nav_links, nav_cta, logo } = data ?? {};

const header: THeader = {
    position: nav_position,
    links: nav_links,
    cta: nav_cta,
    logo: logo.filename_disk,
};

const navPosition = () => {
    switch (header.position) {
        case "CENTER":
            return "mx-auto";
        case "RIGHT":
            return "ml-auto";
        default:
            return "mr-auto";
    }
};
---

<header id="header" class="site-grid bg-primary grid py-4 transition-[top] duration-300">
    <div class="grid-span-body flex items-center gap-12">
        <a href="/"><Image class="[&_svg]:text-current" src={logo.filename_disk} isSvg /></a>
        <nav class:list={["flex items-center gap-12", navPosition()]}>
            <ul class="flex items-center gap-2">
                {
                    header.links.map((link) => (
                        <li>
                            <Link data={link} />
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div
            class="flex items-center justify-end gap-4 **:data-[theme='light']:[&_#dark-icon]:hidden **:data-[theme='dark']:[&_#light-icon]:hidden"
        >
            <button
                data-theme="light"
                id="theme-toggle-button"
                class="hover:bg-link-hover rounded-cta relative cursor-pointer p-[4.5px] [&_svg]:h-4"
            >
                <div id="light-icon" class="flex h-6 items-center"><Icon name="sun" /></div>
                <div id="dark-icon" class="flex h-6 items-center"><Icon name="moon" /></div>
                <span class="sr-only">Toggle theme</span>
            </button>
            <span class="bg-outline h-4 w-0.25 content-['']"></span>
            <Link data={header.cta[0]} icon={["download"]} button={["md"]} />
        </div>
    </div>
</header>
<script>
    const header = document.getElementById("header") as HTMLElement;
    let prevScrollPos = window.pageYOffset;

    if (header) {
        window.addEventListener("scroll", toggleHeader);
    }

    function toggleHeader(): void {
        let currentScrollPos = window.pageYOffset;

        prevScrollPos > currentScrollPos
            ? (header.style.top = "0")
            : (header.style.top = `-${header.scrollHeight}px`);
        prevScrollPos = currentScrollPos;
    }
</script>
