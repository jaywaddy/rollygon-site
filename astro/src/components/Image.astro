---
import { Image as AstroImage } from "astro:assets";
import { parse } from "node-html-parser";
import { BASE_API_URL } from "../lib/directus";

type Props = {
    alt?: string | null;
    aspectRatio?: "square" | "16:9" | "4:3" | "auto";
    class?: string;
    fallback?: string;
    height?: number;
    isSvg?: boolean;
    loading?: "lazy" | "eager";
    quality?: number;
    responsive?: boolean;
    sizes?: string;
    src: string | undefined;
    width?: number;
};

const {
    alt,
    aspectRatio = "auto",
    class: className,
    fallback = "/images/placeholder.svg",
    height = 24,
    loading = "lazy",
    quality = 80,
    responsive = true,
    sizes,
    src,
    isSvg,
    width = 24,
} = Astro.props;

// Early returns for validation
if (!src) {
    console.warn("Image: src prop is required");
    return null;
}

if (!src) {
    console.warn("Image: src prop is required");
    return null;
}

if (height <= 0 || width <= 0) {
    console.warn("Image: height and width must be positive numbers");
    return null;
}

// Define styles object with Tailwind classes
const styles = {
    container: "overflow-hidden",
    image: "object-cover transition-opacity duration-300",
    responsive: "w-full h-auto",
    square: "aspect-square object-cover",
    widescreen: "aspect-video object-cover",
    standard: "aspect-[4/3] object-cover",
};

// Helper function to get aspect ratio classes
const getAspectRatioClass = () => {
    switch (aspectRatio) {
        case "square":
            return styles.square;
        case "16:9":
            return styles.widescreen;
        case "4:3":
            return styles.standard;
        default:
            return responsive ? styles.responsive : "";
    }
};

// Enhanced media URL processing with error handling
function getDirectusMedia(url: string): string | null {
    try {
        if (!url) return null;

        // Return as-is if it's a data URL (base64)
        if (url.startsWith("data:")) return url;

        // Return as-is if it's an absolute URL
        if (url.startsWith("http") || url.startsWith("//")) return url;

        // Prepend BASE_URL for relative URLs
        return `${BASE_API_URL}/assets/${url}`;
    } catch (error) {
        console.error("Image: Error processing image URL:", error);
        return fallback;
    }
}

// Process image URL and prepare safe alt text
const imageUrl = getDirectusMedia(src);

// Early return if no valid image URL
if (!imageUrl) return null;

const safeAlt = alt || `Image ${width}x${height}`;
const imageClasses = `${styles.image} ${getAspectRatioClass()} ${Astro.props.class || ""}`;

// Generate responsive sizes if not provided
const responsiveSizes =
    sizes || (responsive ? "(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw" : undefined);

// SVG implementation
const SVGImages = import.meta.glob<string>("../../../directus/uploads/*.svg", { query: "?raw" });

const getSVG = async (id: string) => {
    const filePath = `../../../directus/uploads/${id}`;

    if (filePath in SVGImages) {
        const { default: file } = (await SVGImages[filePath]()) as unknown as { default: string };
        const root = parse(file);

        const svg = root.querySelector("svg") as unknown as SVGElement;
        const { attributes, innerHTML } = svg;

        return { attributes, innerHTML };
    }

    return SVGImages;
};

const { attributes: baseAttributes, innerHTML } = await getSVG(src);
const svgAttributes = { ...baseAttributes };
---

{
    isSvg ? (
        <div class:list={[styles.container, className, "[&_svg]:h-full"]}>
            <svg class="[&_path]:fill-current" {...svgAttributes} set:html={innerHTML} />
        </div>
    ) : (
        <div class:list={[styles.container, className]}>
            <AstroImage
                src={imageUrl}
                alt={safeAlt}
                height={height}
                width={width}
                loading={loading}
                quality={quality}
                sizes={responsiveSizes}
                class={imageClasses}
            />
        </div>
    )
}
