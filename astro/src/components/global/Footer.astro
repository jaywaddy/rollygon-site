---
import Image from "@components/Image.astro";
import type { TGlobalData } from "../../lib/schema/globalData";
import Cta from "../ui/Cta.astro";
import GlobalGrid from "../../layouts/GlobalGrid.astro";
import { getTools } from "../../lib/schema/tools";
import { getModels } from "../../lib/schema/models";
import Container from "../../layouts/Container.astro";
import type { TCta } from "../../lib/schema";
import type { TIconName } from "@components/ui/Icon.astro";
import Icon from "@components/ui/Icon.astro";
import { getResources } from "../../lib/schema/resources";

type Props = { data: TGlobalData | undefined };
type TFooterGroup = { icon: TIconName; label: string; links: TCta[] };

const { data } = Astro.props;

if (!data) {
    console.warn("Footer: data property is invalid.");
    return null;
}

const { copyright_text, logo, nav_links } = data ?? {};

const LINK_COUNT = 5;

const fetchTools = await getTools({ fields: ["slug", "title"], sort: ["sort", "-date_created"] });
const fetchModels = await getModels({ fields: ["slug", "title"], sort: ["sort", "-date_created"] });
const fetchResources = await getResources({
    fields: ["slug", "title"],
    sort: ["sort", "-date_created"],
});

const tool_links = [...fetchTools].map(({ slug, title }) => {
    return { href: `/tools/${slug}`, label: title };
});
const model_links = [...fetchModels].map(({ slug, title }) => {
    return { href: `/models/${slug}`, label: title };
});
const resource_links = [...fetchResources].map(({ slug, title }) => {
    return { href: `/resources/${slug}`, label: title };
});

const footerGroups: TFooterGroup[] = [
    { icon: "navigation", label: "Navigation", links: nav_links },
    { icon: "tool", label: "Tools", links: tool_links.slice(0, LINK_COUNT) },
    { icon: "model", label: "Models", links: model_links.slice(0, LINK_COUNT) },
    { icon: "resource", label: "Resources", links: resource_links.slice(0, LINK_COUNT) },
];
---

<GlobalGrid class="bg-primary">
    <Container layout="body">
        <div class="border-outline border-b py-8">
            <a href="/" aria-label="Home" class="inline-block">
                <Image src={logo.filename_disk} isSvg />
            </a>
            <div class="w-full"></div>
        </div>
        <div class="grid grid-cols-5 gap-16 py-8">
            {
                footerGroups.map(({ icon, label, links }) => (
                    <ul class="flex flex-col gap-2">
                        <li class="badge">
                            <Icon name={icon} />
                            <span>{label}</span>
                        </li>
                        {links.map((link) => (
                            <li>{<Cta data={link} varient={["md", "link"]} class="w-fit" />}</li>
                        ))}
                    </ul>
                ))
            }
        </div>
    </Container>
    <Container layout="full" tag="small" class="bg-banner flex justify-center py-4 text-[white]">
        <span id="copyright-text" class="text-current">{copyright_text}</span>
    </Container>
</GlobalGrid>
<script>
    const copyrightElement = document.getElementById("copyright-text");
    const currentYear = new Date().getFullYear().toString();

    if (copyrightElement) {
        copyrightElement.innerText = copyrightElement.innerText.replace("{{year}}", currentYear);
    }
</script>
