---
import Input from "@components/ui/Input.astro";
import type { TGlobalData } from "../../lib/schema/globalData";
import GlobalGrid from "../../layouts/GlobalGrid.astro";
import Container from "../../layouts/Container.astro";
import Element from "@components/Element.astro";
import Cta from "@components/ui/Cta.astro";
import Icon from "@components/ui/Icon.astro";
import type { TCta } from "../../lib/schema";
import type { TIconName } from "@components/ui/Icon.astro";

type Props = { data: TGlobalData | undefined };
type TSidebarGroup = { icon: TIconName; label: string; links?: TCta[]; text?: string };

const { data } = Astro.props;

if (!data) {
    console.warn("Contact Form: data is either missing or invalid.");
    return null;
}

const {
    contact_location: location,
    contact_email: email,
    contact_form_body: body,
    contact_form_input_fields: input_fields,
    contact_form_title: title,
    social_links,
} = data ?? {};

const sidebarGroups: TSidebarGroup[] = [
    { icon: "mail", label: "Email", text: email },
    { icon: "location", label: "Location", text: location },
    { icon: "message", label: "Connect", links: social_links },
];
---

<GlobalGrid id="contact-form">
    <Container layout="article">
        <Element tag="section">
            <h2>{title}</h2>
            <div set:html={body} class="pb-4" />
            <form action="https://formsubmit.co/29c37eddc15bd59bcd6a93560581473e" method="POST">
                <input type="text" name="_honey" style="display:none" />
                <input type="hidden" name="_subject" value="New submission!" />
                <input type="hidden" name="_captcha" value="false" />
                <ul class="flex flex-col gap-4">
                    {
                        input_fields.map(({ name, type, label, placeholder, required }) => (
                            <li>
                                <Input id={name} {type} {label} {name} {placeholder} {required} />
                            </li>
                        ))
                    }
                    <li class="flex gap-2">
                        <Cta data={{ label: "Submit" }} icon={["send"]} />
                        <Cta
                            class="w-fit"
                            data={{ label: "Write an email", href: `mailto:${email}` }}
                            icon={["mail"]}
                            varient={["md", "outline"]}
                        />
                    </li>
                </ul>
            </form>
        </Element>
    </Container>
    <Container layout="sidebar" class="card">
        <Element tag="aside">
            <ul class="flex flex-col gap-4">
                {
                    sidebarGroups.map(({ icon, label, links, text }) => (
                        <li>
                            <ul class="flex flex-col gap-1">
                                <li class="badge">
                                    <Icon name={icon} />
                                    <span>{label.toUpperCase()}</span>
                                </li>
                                {text && <li>{text}</li>}
                                <li>
                                    <ul class="flex flex-wrap gap-2">
                                        {links?.map(({ label, href, icon }) => (
                                            <li>
                                                <Cta
                                                    class="w-fit"
                                                    data={{ label, href }}
                                                    varient={["md", "outline"]}
                                                    icon={[icon || "at-sign"]}
                                                />
                                            </li>
                                        ))}
                                    </ul>
                                </li>
                            </ul>
                        </li>
                    ))
                }
            </ul>
        </Element>
    </Container>
</GlobalGrid>
