---
import Cta from "@components/ui/Cta.astro";
import type { TGlobalData } from "../../lib/schema/globalData";
import Container from "../../layouts/Container.astro";
import GlobalGrid from "../../layouts/GlobalGrid.astro";

type Props = { data: TGlobalData };

const { data } = Astro.props;

if (!data) {
    console.error("Failed to fetch global data.");
    return null;
}

const { banner_description, banner_cta, banner_display } = data ?? {};

if (banner_display === "hidden") {
    return null;
}
---

<GlobalGrid id="banner" class="bg-banner text-banner-text">
    <Container
        layout="body"
        style="--color-cta-hover: var(--color-banner-hover);"
        class="flex items-center justify-between py-1"
    >
        <div class="mx-auto flex items-center gap-2">
            <small class="flex gap-2">
                <span class="text-nowrap">{banner_description}</span>
                <span>&mdash;</span>
            </small>
            <Cta data={banner_cta[0]} varient={["sm", "outline"]} icon={["new"]} />
        </div>
        <Cta
            id="dismiss-button"
            data={{ label: "Close banner" }}
            varient={["md", "ghost"]}
            icon={["close"]}
            iconOnly
        />
    </Container>
</GlobalGrid>
<script>
    const banner = document.getElementById("banner");
    const dismissButton = document.getElementById("dismiss-button");

    if (banner && dismissButton) {
        dismissButton.addEventListener("click", () => {
            banner.style.display = "none";
        });
    }
</script>
