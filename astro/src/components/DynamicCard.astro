---
import { getModelById } from "../lib/schema/models";
import { getResourceById } from "../lib/schema/resources";
import { getToolById } from "../lib/schema/tools";
import type { TAsset } from "../lib/schema";
import TextCard from "./TextCard.astro";
import ImageCard from "./ImageCard.astro";

type Props = { data: TAsset; imageOff?: boolean };

const { data, imageOff } = Astro.props;

if (!data) {
    console.warn("Asset Card: data prop is either missing or invalid.");
    return null;
}

const { collection, key } = data ?? {};

const toolData =
    collection === "tools"
        ? await getToolById(key, {
              fields: ["description", "featured_image", "price", "slug", "title"],
          })
        : {};

const resourceData =
    collection === "resources"
        ? await getResourceById(key, {
              fields: ["categories", "description", "featured_image", "slug", "title"],
          })
        : {};

const modelData =
    collection === "models"
        ? await getModelById(key, { fields: ["description", "featured_image", "slug", "title"] })
        : {};

const {
    description: t_description,
    featured_image: t_featured_image,
    price,
    slug: t_slug,
    title: t_title,
} = toolData ?? {};

const {
    categories,
    description: r_description,
    featured_image: r_featured_image,
    slug: r_slug,
    title: r_title,
} = resourceData ?? {};

const {
    description: m_description,
    featured_image: m_featured_image,
    slug: m_slug,
    title: m_title,
} = modelData ?? {};

const description = t_description || m_description || r_description;
const featured_image = t_featured_image || m_featured_image || r_featured_image;
const slug = t_slug || m_slug || r_slug;
const title = t_title || m_title || r_title;
---

{
    collection === "resources" ? (
        <TextCard data={{ categories, description, featured_image, slug, title }} {imageOff} />
    ) : (
        <ImageCard data={{ collection, description, featured_image, price, slug, title }} />
    )
}
