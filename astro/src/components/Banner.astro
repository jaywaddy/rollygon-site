---
import type { TBanner } from "../types";
import Link from "./ui/Link.astro";

type Props = { data: TBanner | undefined };

const { data: banner } = Astro.props;

if (!banner || !banner?.isVisible) {
    console.warn("Banner: data is either invalid or not visible.");
    return null;
}
---

<div
    id="banner"
    class="bg-primary border-cta-primary-content relative flex items-center justify-center border-b py-2"
>
    <small class="flex items-center gap-2">
        <span>{banner.description}</span>
        <span>&mdash;</span>
        <Link data={banner.cta} />
    </small>
    <button id="dismiss-button" class="cta-hover absolute right-4 cursor-pointer border-none">
        &#x2715;
    </button>
</div>
<script>
    const banner = document.getElementById("banner");
    const dismissButton = document.getElementById("dismiss-button");

    if (banner && dismissButton) {
        dismissButton.addEventListener("click", () => {
            banner.style.display = "none";
        });
    }
</script>
