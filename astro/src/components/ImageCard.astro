---
import Image from "./Image.astro";
import Badge from "./ui/Badge.astro";
import type { TIconName } from "./ui/Icon.astro";
import Seperator from "./ui/Seperator.astro";

type TAssetVarient = {
    icon?: TIconName;
    badges: TBadge[] | undefined;
    label?: string;
    slug?: string;
    style?: { [key: string]: string };
    class?: { [key: string]: string };
};
type TBadge = { icon: TIconName; label: string };
type Props = { class?: string; data: any };

const { class: className, data } = Astro.props;

if (!data) {
    console.warn("TextCard: data property is either missing or invalid.");
    return null;
}

const { collection, description, featured_image, price, slug, title } = data ?? {};

const assetVarients: { [key: string]: TAssetVarient } = {
    models: {
        badges: [{ icon: "model", label: "3D Model" }],
        class: {
            container: "rounded-element min-h-96 p-6 text-zinc-50",
            gradient: "asset-gradient bg-zinc-700",
            image: "absolute inset-0 h-full",
            info: "mt-auto",
        },
        slug: `/models/${slug}`,
        style: { gradient: "--color: var(--color-zinc-800);" },
    },
    tools: {
        badges: [
            { icon: "tool", label: "Tool" },
            { icon: "download", label: price?.toString() || "Free" },
        ],
        class: {
            container: "rounded-element min-h-96 h-full p-6 text-zinc-50",
            gradient: "asset-gradient bg-zinc-700",
            image: "absolute inset-0 h-full",
            info: "mt-auto",
            slug: `/tools/${slug}`,
        },
        style: { gradient: "--color: var(--color-zinc-800);" },
    },
};

const badges = assetVarients[collection].badges ?? [];
---

<section
    class:list={[
        "relative flex overflow-clip",
        assetVarients[collection].class?.container,
        className,
    ]}
>
    <Image class:list={[assetVarients[collection].class?.image]} src={featured_image} />
    <div
        class="absolute inset-0 w-full bg-linear-to-b from-transparent from-20% to-zinc-950 content-['']"
    >
    </div>
    <div
        style={assetVarients[collection].style?.gradient}
        class:list={["absolute inset-0 content-['']", assetVarients[collection].class?.gradient]}
    >
    </div>
    <div class:list={["z-10 w-full", assetVarients[collection].class?.info]}>
        <div class="flex max-w-2xl flex-col gap-1">
            <a href="">
                <h3>{title}</h3>
            </a>
            {description && <p class="lead">{description}</p>}
            <div class="z-10 mt-2 flex items-center gap-4">
                {
                    badges.map((badge, index) =>
                        index < badges.length - 1 ? (
                            <>
                                <Badge {badge} />
                                <Seperator />
                            </>
                        ) : (
                            <Badge {badge} />
                        ),
                    )
                }
            </div>
        </div>
    </div>
</section>
