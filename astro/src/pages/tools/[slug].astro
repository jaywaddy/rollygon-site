---
import GlobalLayout from "../../layouts/GlobalLayout.astro";
import { getStrapiData } from "../../api";
import type { TToolData } from "../../types";
import StrapiBlocksRenderer from "@components/StrapiBlocksRenderer.astro";

export async function getStaticPaths() {
    const allToolData = await getStrapiData<TToolData[]>("/api/tools");

    if (allToolData.error) {
        console.error("Failed to fetch global data:", allToolData.error?.message);
        throw new Error(allToolData.error?.message);
    }

    if (!allToolData.data) {
        console.warn("Tool Data: data is either missing or invalid.");
        return null;
    }

    return allToolData.data?.map((tool) => ({ params: { slug: tool.slug }, props: tool }));
}

const { title, description, body } = Astro.props;
---

<GlobalLayout {title} {description}>
    <h1>{title}</h1>
    <StrapiBlocksRenderer content={body} />
</GlobalLayout>
