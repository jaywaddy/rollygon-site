---
import ContentWrapper from "@components/global/ContentWrapper.astro";
import GlobalLayout from "../layouts/GlobalLayout.astro";
import Cta from "@components/ui/Cta.astro";
import GlobalGrid from "../layouts/GlobalGrid.astro";
import Container from "../layouts/Container.astro";
import Element from "@components/Element.astro";
import { getLandingPage } from "../lib/schema/landingPage";
import AssetCard from "@components/AssetCard.astro";
import Icon from "@components/ui/Icon.astro";
import LandingHero from "@components/LandingHero.astro";

const data = await getLandingPage();

const {
    cta_buttons,
    featured_model,
    featured_resource,
    featured_tool,
    hero_subtitle,
    hero_title,
    seo,
    title,
} = data ?? {};
---

<GlobalLayout title="Home">
    <LandingHero {data} />
    <ContentWrapper>
        <Container layout="content" class="grid-span-content"> content </Container>
    </ContentWrapper>
</GlobalLayout>
