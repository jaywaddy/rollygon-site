---
import ContentWrapper from "@components/global/ContentWrapper.astro";
import GlobalLayout from "../layouts/GlobalLayout.astro";
import Cta from "@components/ui/Cta.astro";
import GlobalGrid from "../layouts/GlobalGrid.astro";
import Container from "../layouts/Container.astro";
import Element from "@components/Element.astro";
import { getLandingPage } from "../lib/schema/landingPage";
import DynamicCard from "@components/DynamicCard.astro";
import LandingHero from "@components/LandingHero.astro";

const data = await getLandingPage();

const {
    cta_buttons,
    featured_model,
    featured_resources,
    featured_tool,
    hero_subtitle,
    hero_title,
    seo,
    title,
} = data ?? {};
---

<GlobalLayout title="Home">
    <LandingHero {data} />
    <ContentWrapper>
        <DynamicCard data={featured_model} />
        {featured_resources.map((resource) => <DynamicCard data={resource} />)}
    </ContentWrapper>
</GlobalLayout>
