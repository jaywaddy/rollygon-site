---
import type { HTMLTag } from "astro/types";

type TGridLayout =
    | "full"
    | "body"
    | "content"
    | "article"
    | "sidebar"
    | "left-gutter"
    | "right-gutter";

type Props = { class?: string; id?: string; layout: TGridLayout; tag?: HTMLTag };
const { class: className, id, layout, tag } = Astro.props;

if (!layout) {
    console.warn("Container: layout property is invalid.");
    return null;
}

const layouts: { [layout in TGridLayout]: string } = {
    "full": "col-span-full",
    "body": "col-start-2 col-end-10",
    "content": "col-start-3 col-end-9", // Needs attention
    "article": "col-start-3 col-end-7", // Needs attention
    "sidebar": "col-start-7 col-end-9", // Needs attention
    "left-gutter": "col-start-1 col-end-2",
    "right-gutter": "col-start-9 col-end-10",
};

const Tag = tag || "div";
---

<Tag {id} class=`${layouts[layout]} ${className}`>
    <slot />
</Tag>
