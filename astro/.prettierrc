{
    "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro",
                "singleQuote": false,
                "bracketSpacing": true,
                "semi": true,
                "printWidth": 100,
                "objectWrap": "collapse",
                "quoteProps": "consistent"
            }
        }
    ]
}
