{
  "kind": "collectionType",
  "collectionName": "models",
  "info": {
    "singularName": "model",
    "pluralName": "models",
    "displayName": "Models"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "modelEmbedID": {
      "type": "string",
      "required": false
    },
    "datePosted": {
      "type": "date"
    },
    "dateUpdated": {
      "type": "date"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "verticies": {
      "type": "decimal"
    },
    "trianlges": {
      "type": "decimal"
    },
    "quads": {
      "type": "decimal"
    },
    "featuredTools": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tool.tool"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "body": {
      "type": "richtext"
    }
  }
}
