{
  "kind": "collectionType",
  "collectionName": "tools",
  "info": {
    "singularName": "tool",
    "pluralName": "tools",
    "displayName": "Tools"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "customField",
      "customField": "plugin::auto-slug.slug",
      "options": {
        "unique": true,
        "autoGenerateOnCreate": true,
        "stopOnManualEdit": false,
        "preserveOnEdit": true,
        "autoGenerateIfEmpty": true,
        "sourceField": "title"
      },
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "legacyPublishDate": {
      "type": "date"
    },
    "version": {
      "type": "float"
    },
    "price": {
      "type": "decimal"
    },
    "externalLink": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "programs": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[\"blender\"]",
      "options": [
        "blender"
      ]
    },
    "featuredModels": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::model.model"
    },
    "body": {
      "type": "blocks"
    }
  }
}
