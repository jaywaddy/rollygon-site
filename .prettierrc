{
	"plugins": [
		"prettier-plugin-astro",
		"prettier-plugin-tailwindcss",
		"@trivago/prettier-plugin-sort-imports"
	],
	"overrides": [
		{
			"files": ["*.astro"],
			"options": {
				"parser": "astro",
				"singleQuote": false,
				"bracketSpacing": true,
				"semi": true,
				"printWidth": 100,
				"objectWrap": "collapse",
				"quoteProps": "consistent",
				"tabWidth": 4,
				"useTabs": true,
				"importOrder": ["^components/(.*)$", "^[./]"],
				"importOrderSeparation": true,
				"importOrderSortSpecifiers": true
			}
		}
	],
	"importOrder": [
		"<THIRD_PARTY_MODULES>",
		"interface",
		"(?=content|api)",
		"context/",
		"mock/",
		"config",
		"utils/",
		"hooks/",
		"(components/|./index)",
		".svg",
		"^../(.*)$",
		"(?=./styles.module.scss)"
	]
}
