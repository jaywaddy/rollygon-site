{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "metaTitle": {
      "type": "string",
      "minLength": 41,
      "maxLength": 51
    },
    "canonicalUrl": {
      "type": "string"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time"
    },
    "dateUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "metaDescription": {
      "type": "string",
      "minLength": 51,
      "maxLength": 151
    },
    "sketchfabUrl": {
      "type": "string"
    },
    "YouTubeEmbed": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "plural": {
      "default": "models",
      "type": "string"
    },
    "singular": {
      "default": "model",
      "type": "string"
    },
    "thumbnail": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "dateCreated",
    "description"
  ]
}