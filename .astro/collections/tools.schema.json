{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "metaTitle": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time"
    },
    "dateUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "metaDescription": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "robots": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sketchfabUrl": {
      "type": "string"
    },
    "youtubeUrl": {
      "type": "string"
    },
    "plural": {
      "default": "tools",
      "type": "string"
    },
    "singular": {
      "default": "tool",
      "type": "string"
    },
    "thumbnail": {
      "type": "string"
    },
    "downloadLink": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "size": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "dateCreated",
    "description"
  ]
}